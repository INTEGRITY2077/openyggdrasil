{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/consumption_request.v1.schema.json",
  "title": "OpenYggdrasil Consumption Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "consumption_request_ref",
    "created_at",
    "worker4_verdict_ref",
    "worker4_verdict",
    "source_production_receipt_ref",
    "approved_routing_fact_ref",
    "ptc_code_execution_session_ref",
    "recall_support_bundle_ref",
    "requested_answer_category",
    "evidence_refs",
    "raw_provider_material_included",
    "skill_body_included",
    "portable_local_path_included",
    "fabricated_answer",
    "no_overclaim_boundary",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {
      "const": "consumption_request.v1"
    },
    "consumption_request_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "worker4_verdict_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "worker4_verdict": {
      "const": "PASS"
    },
    "source_production_receipt_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "approved_routing_fact_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "ptc_code_execution_session_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "recall_support_bundle_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "requested_answer_category": {
      "$ref": "#/$defs/answer_category"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/evidence_ref"
      }
    },
    "raw_provider_material_included": {
      "const": false
    },
    "skill_body_included": {
      "const": false
    },
    "portable_local_path_included": {
      "const": false
    },
    "fabricated_answer": {
      "const": false
    },
    "no_overclaim_boundary": {
      "$ref": "#/$defs/no_overclaim_boundary"
    },
    "reason_codes": {
      "$ref": "#/$defs/reason_codes"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "safe_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^\\s]+$",
      "not": {
        "anyOf": [
          {
            "pattern": "^[Ff][Ii][Ll][Ee]://"
          },
          {
            "pattern": "^[A-Za-z]:"
          },
          {
            "pattern": "(?i)\\.skill\\.md"
          },
          {
            "pattern": "(?i)transcript\\.txt"
          }
        ]
      }
    },
    "answer_category": {
      "type": "string",
      "enum": [
        "memory_recall",
        "decision_explanation",
        "status_summary",
        "support_bundle_summary"
      ]
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "ref",
        "evidence_kind",
        "resolution_status",
        "evidence_status",
        "pointer_accounting_key"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/identifier"
        },
        "ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "evidence_kind": {
          "type": "string",
          "enum": [
            "production_receipt",
            "approved_routing_fact",
            "ptc_code_execution_session",
            "ptc_egress_payload",
            "worker4_verification",
            "support_bundle",
            "route_decision"
          ]
        },
        "resolution_status": {
          "const": "resolved"
        },
        "evidence_status": {
          "const": "current"
        },
        "pointer_accounting_key": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "no_overclaim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_readiness_claimed",
        "production_readiness_claimed",
        "reasoning_lease_solved_claimed",
        "public_runtime_integration_complete_claimed",
        "readiness_91_percent_claimed"
      ],
      "properties": {
        "live_readiness_claimed": {
          "const": false
        },
        "production_readiness_claimed": {
          "const": false
        },
        "reasoning_lease_solved_claimed": {
          "const": false
        },
        "public_runtime_integration_complete_claimed": {
          "const": false
        },
        "readiness_91_percent_claimed": {
          "const": false
        }
      }
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    }
  }
}
