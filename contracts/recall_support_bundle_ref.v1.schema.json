{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/recall_support_bundle_ref.v1.schema.json",
  "title": "openyggdrasil Recall Support Bundle Ref v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "support_bundle_ref",
    "created_at",
    "source_evidence_refs",
    "selected_memory_refs",
    "rejected_memory_refs",
    "stale_refs_rejected",
    "decoy_refs_rejected",
    "graphify_refs_non_sot",
    "raw_provider_material_included",
    "skill_body_included",
    "portable_local_path_included",
    "no_overclaim_boundary",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {
      "const": "recall_support_bundle_ref.v1"
    },
    "support_bundle_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/evidence_ref"
      }
    },
    "selected_memory_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/selected_memory_ref"
      }
    },
    "rejected_memory_refs": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/rejected_memory_ref"
      }
    },
    "stale_refs_rejected": {
      "const": true
    },
    "decoy_refs_rejected": {
      "const": true
    },
    "graphify_refs_non_sot": {
      "const": true
    },
    "raw_provider_material_included": {
      "const": false
    },
    "skill_body_included": {
      "const": false
    },
    "portable_local_path_included": {
      "const": false
    },
    "no_overclaim_boundary": {
      "$ref": "#/$defs/no_overclaim_boundary"
    },
    "reason_codes": {
      "$ref": "#/$defs/reason_codes"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "safe_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^\\s]+$",
      "not": {
        "anyOf": [
          {
            "pattern": "^[Ff][Ii][Ll][Ee]://"
          },
          {
            "pattern": "^[A-Za-z]:"
          },
          {
            "pattern": "(?i)\\.skill\\.md"
          },
          {
            "pattern": "(?i)transcript\\.txt"
          }
        ]
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "ref",
        "evidence_kind",
        "resolution_status",
        "evidence_status",
        "pointer_accounting_key"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/identifier"
        },
        "ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "evidence_kind": {
          "type": "string",
          "enum": [
            "production_receipt",
            "approved_routing_fact",
            "ptc_code_execution_session",
            "ptc_egress_payload",
            "worker4_verification",
            "support_bundle",
            "route_decision"
          ]
        },
        "resolution_status": {
          "const": "resolved"
        },
        "evidence_status": {
          "const": "current"
        },
        "pointer_accounting_key": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "selected_memory_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "role",
        "reason_code",
        "memory_status"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "role": {
          "$ref": "#/$defs/identifier"
        },
        "reason_code": {
          "$ref": "#/$defs/identifier"
        },
        "memory_status": {
          "const": "current"
        }
      }
    },
    "rejected_memory_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "role",
        "reason_code",
        "memory_status",
        "rejected"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "role": {
          "$ref": "#/$defs/identifier"
        },
        "reason_code": {
          "$ref": "#/$defs/identifier"
        },
        "memory_status": {
          "type": "string",
          "enum": [
            "stale",
            "superseded",
            "decoy",
            "unresolved",
            "graphify_non_sot"
          ]
        },
        "rejected": {
          "const": true
        }
      }
    },
    "no_overclaim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_readiness_claimed",
        "production_readiness_claimed",
        "reasoning_lease_solved_claimed",
        "public_runtime_integration_complete_claimed",
        "readiness_91_percent_claimed"
      ],
      "properties": {
        "live_readiness_claimed": {
          "const": false
        },
        "production_readiness_claimed": {
          "const": false
        },
        "reasoning_lease_solved_claimed": {
          "const": false
        },
        "public_runtime_integration_complete_claimed": {
          "const": false
        },
        "readiness_91_percent_claimed": {
          "const": false
        }
      }
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    }
  }
}
