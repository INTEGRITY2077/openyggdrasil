{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/decision_timeline_event.v1.schema.json",
  "title": "Decision Timeline Event v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "timeline_event_id",
    "event_kind",
    "provider_source_event_ref",
    "previous_decision_ref",
    "new_decision_ref",
    "created_at",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {"const": "decision_timeline_event.v1"},
    "timeline_event_id": {"type": "string", "minLength": 1},
    "event_kind": {"type": "string", "minLength": 1},
    "provider_source_event_ref": {"type": "string", "minLength": 1},
    "previous_decision_ref": {"type": "string"},
    "new_decision_ref": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
