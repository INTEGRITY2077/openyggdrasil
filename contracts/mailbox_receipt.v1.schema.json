{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contract-ref://openyggdrasil/contracts/mailbox_receipt.v1.schema.json",
  "title": "Mailbox Receipt Schema v1",
  "description": "OpenYggdrasil mailbox receipt schema. Operator → Provider reverse push notification.",
  "type": "object",
  "required": ["receipt_id", "in_reply_to", "status", "timestamp"],
  "properties": {
    "receipt_id": {
      "type": "string",
      "description": "영수증 고유 식별자"
    },
    "in_reply_to": {
      "type": "string",
      "description": "응답 대상 intent의 mail_id"
    },
    "status": {
      "type": "string",
      "enum": ["delivered", "completed", "failed", "typed_unavailable"],
      "description": "처리 상태"
    },
    "produced_count": {
      "type": "integer",
      "description": "Producer가 생성한 Vault 노드 수"
    },
    "nodes": {
      "type": "array",
      "items": {"type": "string"},
      "description": "생성된 노드 ID 목록"
    },
    "bundle": {
      "type": "object",
      "description": "Consumer 검색 결과 번들 (query intent 응답)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "operator_pid": {
      "type": "integer"
    },
    "_provider_action": {
      "type": "object",
      "description": "[Q12] 영수증 어포던스 — 프로바이더가 영수증을 읽었을 때의 행동 지침.",
      "properties": {
        "what_happened": {
          "type": "string",
          "description": "처리 결과 요약"
        },
        "what_to_do_next": {
          "type": "string",
          "description": "다음 행동 안내"
        },
        "do_not": {
          "type": "string",
          "description": "하지 말아야 할 행동"
        }
      }
    }
  }
}
