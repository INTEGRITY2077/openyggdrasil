{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/graph_structure_quality_gate.v1.schema.json",
  "title": "openyggdrasil Graph Structure Quality Gate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate_id",
    "created_at",
    "graph_hint_ref",
    "producer_receipt_ref",
    "consumer_receipt_ref",
    "graph_snapshot_ref",
    "snapshot_freshness_status",
    "canonical_authority",
    "edge_records",
    "node_records",
    "community_records",
    "evidence_refs",
    "guards",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {
      "const": "graph_structure_quality_gate.v1"
    },
    "gate_id": {
      "$ref": "#/$defs/identifier"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "graph_hint_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "producer_receipt_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "consumer_receipt_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "graph_snapshot_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "snapshot_freshness_status": {
      "const": "fresh_against_receipt_basis"
    },
    "canonical_authority": {
      "const": "none"
    },
    "edge_records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/edge_record"
      }
    },
    "node_records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/node_record"
      }
    },
    "community_records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/community_record"
      }
    },
    "graph_hint_helped_answer_quality_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "evidence_refs": {
      "$ref": "#/$defs/evidence_refs"
    },
    "guards": {
      "$ref": "#/$defs/guards"
    },
    "reason_codes": {
      "$ref": "#/$defs/reason_codes"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "safe_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^\\s]+$",
      "not": {
        "anyOf": [
          {
            "pattern": "^[Ff][Ii][Ll][Ee]://"
          },
          {
            "pattern": "^[A-Za-z]:"
          },
          {
            "pattern": "(?i)credential"
          },
          {
            "pattern": "(?i)raw[-_ ]?(transcript|provider|stdout|stderr)"
          },
          {
            "pattern": "(?i)decoy"
          },
          {
            "pattern": "(?i)stale"
          }
        ]
      }
    },
    "edge_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "source_node_ref",
        "target_node_ref",
        "edge_basis_refs"
      ],
      "properties": {
        "edge_id": {
          "$ref": "#/$defs/identifier"
        },
        "source_node_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "target_node_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "edge_basis_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/safe_ref"
          }
        }
      }
    },
    "node_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id",
        "node_ref"
      ],
      "anyOf": [
        {
          "required": [
            "node_category_refs"
          ]
        },
        {
          "required": [
            "typed_unresolved_node_status"
          ]
        }
      ],
      "properties": {
        "node_id": {
          "$ref": "#/$defs/identifier"
        },
        "node_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "node_category_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/safe_ref"
          }
        },
        "typed_unresolved_node_status": {
          "const": "typed_unresolved"
        }
      }
    },
    "community_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "community_id",
        "community_ref",
        "community_reason_refs"
      ],
      "properties": {
        "community_id": {
          "$ref": "#/$defs/identifier"
        },
        "community_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "community_reason_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/safe_ref"
          }
        }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "ref",
        "evidence_kind",
        "resolution_status"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/identifier"
        },
        "ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "evidence_kind": {
          "type": "string",
          "enum": [
            "producer_receipt",
            "consumer_receipt",
            "graph_non_sot_hint",
            "graph_snapshot",
            "edge_basis",
            "node_category",
            "community_reason",
            "scorecard"
          ]
        },
        "resolution_status": {
          "const": "resolved"
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 4,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/evidence_ref"
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graphify_as_sot",
        "edge_without_basis_refs_accepted",
        "node_without_category_refs_or_unresolved_status_accepted",
        "community_without_reason_refs_accepted",
        "stale_graph_snapshot_accepted",
        "decoy_graph_ref_accepted",
        "graph_hint_helped_answer_quality_without_scorecard_evidence",
        "local_filesystem_path_included",
        "raw_transcript_included",
        "raw_skill_body_included",
        "raw_stdout_included",
        "raw_stderr_included",
        "provider_context_included",
        "live_process_handles_included"
      ],
      "properties": {
        "graphify_as_sot": {
          "const": false
        },
        "edge_without_basis_refs_accepted": {
          "const": false
        },
        "node_without_category_refs_or_unresolved_status_accepted": {
          "const": false
        },
        "community_without_reason_refs_accepted": {
          "const": false
        },
        "stale_graph_snapshot_accepted": {
          "const": false
        },
        "decoy_graph_ref_accepted": {
          "const": false
        },
        "graph_hint_helped_answer_quality_without_scorecard_evidence": {
          "const": false
        },
        "local_filesystem_path_included": {
          "const": false
        },
        "raw_transcript_included": {
          "const": false
        },
        "raw_skill_body_included": {
          "const": false
        },
        "raw_stdout_included": {
          "const": false
        },
        "raw_stderr_included": {
          "const": false
        },
        "provider_context_included": {
          "const": false
        },
        "live_process_handles_included": {
          "const": false
        }
      }
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    }
  }
}
