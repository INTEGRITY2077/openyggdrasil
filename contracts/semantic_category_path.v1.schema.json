{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/semantic_category_path.v1.schema.json",
  "title": "Semantic Category Path v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "segments",
    "path",
    "category_authority",
    "physical_storage_is_not_semantic_category",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {"const": "semantic_category_path.v1"},
    "segments": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "path": {"type": "string", "minLength": 1},
    "category_authority": {
      "type": "object",
      "additionalProperties": true,
      "required": ["owner", "basis_refs"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "decision_ref": {"type": ["string", "null"]},
        "basis_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "physical_storage_is_not_semantic_category": {"const": true},
    "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
