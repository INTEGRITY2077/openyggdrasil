{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/graph_non_sot_hint.v1.schema.json",
  "title": "openyggdrasil Graph Non-SOT Hint v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hint_id",
    "created_at",
    "producer_receipt_ref",
    "consumer_receipt_ref",
    "graph_snapshot_ref",
    "graph_output_role",
    "graphify_is_sot",
    "canonical_mutation_allowed",
    "provider_may_answer_from_graph_alone",
    "derived_label_namespace_ref",
    "canonical_label_namespace_ref",
    "derived_labels",
    "evidence_refs",
    "guards",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {
      "const": "graph_non_sot_hint.v1"
    },
    "hint_id": {
      "$ref": "#/$defs/identifier"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer_receipt_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "consumer_receipt_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "graph_snapshot_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "graph_output_role": {
      "const": "non_sot_visibility_hint"
    },
    "graphify_is_sot": {
      "const": false
    },
    "canonical_mutation_allowed": {
      "const": false
    },
    "provider_may_answer_from_graph_alone": {
      "const": false
    },
    "derived_label_namespace_ref": {
      "$ref": "#/$defs/derived_label_namespace_ref"
    },
    "canonical_label_namespace_ref": {
      "$ref": "#/$defs/canonical_label_namespace_ref"
    },
    "derived_labels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/derived_label"
      }
    },
    "evidence_refs": {
      "$ref": "#/$defs/evidence_refs"
    },
    "guards": {
      "$ref": "#/$defs/guards"
    },
    "reason_codes": {
      "$ref": "#/$defs/reason_codes"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "safe_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^\\s]+$",
      "not": {
        "anyOf": [
          {
            "pattern": "^[Ff][Ii][Ll][Ee]://"
          },
          {
            "pattern": "^[A-Za-z]:"
          },
          {
            "pattern": "(?i)credential"
          },
          {
            "pattern": "(?i)raw[-_ ]?(transcript|provider|stdout|stderr)"
          }
        ]
      }
    },
    "derived_label_namespace_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/safe_ref"
        },
        {
          "pattern": "^derived-label-namespace-ref://"
        }
      ]
    },
    "canonical_label_namespace_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/safe_ref"
        },
        {
          "pattern": "^canonical-label-namespace-ref://"
        }
      ]
    },
    "provider_safe_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600,
      "not": {
        "anyOf": [
          {
            "pattern": "(?i)raw provider context"
          },
          {
            "pattern": "(?i)raw transcript"
          },
          {
            "pattern": "(?i)raw skill body"
          },
          {
            "pattern": "(?i)raw stdout"
          },
          {
            "pattern": "(?i)raw stderr"
          },
          {
            "pattern": "(?i)live process handle"
          },
          {
            "pattern": "(?i)credential"
          },
          {
            "pattern": "[A-Za-z]:\\\\"
          },
          {
            "pattern": "^[Ff][Ii][Ll][Ee]://"
          }
        ]
      }
    },
    "derived_label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label_id",
        "label_text",
        "namespace_ref",
        "canonical_category_label",
        "evidence_refs"
      ],
      "properties": {
        "label_id": {
          "$ref": "#/$defs/identifier"
        },
        "label_text": {
          "$ref": "#/$defs/provider_safe_text"
        },
        "namespace_ref": {
          "$ref": "#/$defs/derived_label_namespace_ref"
        },
        "canonical_category_label": {
          "const": false
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs"
        }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "ref",
        "evidence_kind",
        "resolution_status"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/identifier"
        },
        "ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "evidence_kind": {
          "type": "string",
          "enum": [
            "producer_receipt",
            "consumer_receipt",
            "graph_snapshot",
            "scorecard",
            "category_tree_transaction"
          ]
        },
        "resolution_status": {
          "const": "resolved"
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/evidence_ref"
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graphify_as_sot",
        "ambiguous_derived_canonical_label_namespace",
        "raw_transcript_included",
        "raw_skill_body_included",
        "raw_stdout_included",
        "raw_stderr_included",
        "provider_context_included",
        "live_process_handles_included",
        "local_filesystem_path_included"
      ],
      "properties": {
        "graphify_as_sot": {
          "const": false
        },
        "ambiguous_derived_canonical_label_namespace": {
          "const": false
        },
        "raw_transcript_included": {
          "const": false
        },
        "raw_skill_body_included": {
          "const": false
        },
        "raw_stdout_included": {
          "const": false
        },
        "raw_stderr_included": {
          "const": false
        },
        "provider_context_included": {
          "const": false
        },
        "live_process_handles_included": {
          "const": false
        },
        "local_filesystem_path_included": {
          "const": false
        }
      }
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    }
  }
}
