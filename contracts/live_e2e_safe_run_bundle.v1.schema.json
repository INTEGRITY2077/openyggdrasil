{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/live_e2e_safe_run_bundle.v1.schema.json",
  "title": "OpenYggdrasil Live E2E Safe Run Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "run_id",
    "provider_name",
    "provider_profile",
    "provider_session_id",
    "artifact_root_ref",
    "artifact_root_initialized",
    "capture_refs",
    "capture_ref_count",
    "raw_transcript_included",
    "same_run_only",
    "may_start_physical_live_probe",
    "may_claim_live_ready",
    "may_claim_91_percent_readiness",
    "claim_scope",
    "reason_codes",
    "checked_at"
  ],
  "properties": {
    "schema_version": {
      "const": "live_e2e_safe_run_bundle.v1"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "provider_name": {
      "const": "hermes"
    },
    "provider_profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "provider_session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "artifact_root_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "artifact_root_initialized": {
      "const": true
    },
    "capture_refs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "capture_ref_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 32
    },
    "raw_transcript_included": {
      "const": false
    },
    "same_run_only": {
      "const": true
    },
    "may_start_physical_live_probe": {
      "const": false
    },
    "may_claim_live_ready": {
      "const": false
    },
    "may_claim_91_percent_readiness": {
      "const": false
    },
    "claim_scope": {
      "const": "safe_live_e2e_artifact_root_only"
    },
    "reason_codes": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "pattern": "^[A-Za-z0-9._:-]+$"
      }
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
