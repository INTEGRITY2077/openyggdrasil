{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/hermes_profile_acquisition_manifest.v1.schema.json",
  "title": "openyggdrasil Hermes Profile Acquisition Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "run_id",
    "provider_name",
    "profile_id",
    "profile_available",
    "profile_status",
    "profile_ref",
    "profile_kind",
    "profile_fingerprint",
    "safe_evidence_refs",
    "raw_transcript_included",
    "credential_ref_included",
    "local_path_included",
    "may_start_foreground_smoke",
    "may_claim_live_ready",
    "may_claim_91_percent_readiness",
    "claim_scope",
    "rerun_condition",
    "reason_codes",
    "checked_at"
  ],
  "properties": {
    "schema_version": {
      "const": "hermes_profile_acquisition_manifest.v1"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "provider_name": {
      "const": "hermes"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "profile_available": {
      "type": "boolean"
    },
    "profile_status": {
      "type": "string",
      "enum": [
        "present",
        "typed_unavailable",
        "invalid"
      ]
    },
    "profile_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/safe_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "profile_kind": {
      "type": "string",
      "enum": [
        "profile_directory",
        "profile_bundle",
        "typed_unavailable"
      ]
    },
    "profile_fingerprint": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "safe_evidence_refs": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/safe_ref"
      }
    },
    "raw_transcript_included": {
      "const": false
    },
    "credential_ref_included": {
      "const": false
    },
    "local_path_included": {
      "const": false
    },
    "may_start_foreground_smoke": {
      "const": false
    },
    "may_claim_live_ready": {
      "const": false
    },
    "may_claim_91_percent_readiness": {
      "const": false
    },
    "claim_scope": {
      "const": "hermes_profile_acquisition_only"
    },
    "rerun_condition": {
      "anyOf": [
        {
          "const": "provide_yggdrasilfgpoc_profile_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason_codes": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "pattern": "^[A-Za-z0-9._:-]+$"
      }
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "safe_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^\\s]+$"
    }
  }
}
