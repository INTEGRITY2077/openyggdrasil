{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/follow_up_production_request_candidate.v1.schema.json",
  "title": "OpenYggdrasil Follow-up Production Request Candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "created_at",
    "source_graph_hint_ref",
    "source_quality_signal_ref",
    "candidate_ref",
    "candidate_status",
    "mutation_policy",
    "direct_canonical_mutation",
    "canonical_mutation_allowed",
    "evidence_refs",
    "guards",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {
      "const": "follow_up_production_request_candidate.v1"
    },
    "candidate_id": {
      "$ref": "#/$defs/identifier"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_graph_hint_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "source_quality_signal_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "candidate_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "candidate_status": {
      "const": "candidate_only"
    },
    "mutation_policy": {
      "const": "no_direct_canonical_mutation"
    },
    "direct_canonical_mutation": {
      "const": false
    },
    "canonical_mutation_allowed": {
      "const": false
    },
    "evidence_refs": {
      "$ref": "#/$defs/evidence_refs"
    },
    "guards": {
      "$ref": "#/$defs/guards"
    },
    "reason_codes": {
      "$ref": "#/$defs/reason_codes"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "safe_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^\\s]+$",
      "not": {
        "anyOf": [
          {
            "pattern": "^[Ff][Ii][Ll][Ee]://"
          },
          {
            "pattern": "^[A-Za-z]:"
          },
          {
            "pattern": "(?i)credential"
          },
          {
            "pattern": "(?i)raw[-_ ]?(transcript|provider|stdout|stderr)"
          }
        ]
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "ref",
        "evidence_kind",
        "resolution_status"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/identifier"
        },
        "ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "evidence_kind": {
          "type": "string",
          "enum": [
            "graph_non_sot_hint",
            "answer_quality_signal",
            "consumer_receipt",
            "producer_receipt"
          ]
        },
        "resolution_status": {
          "const": "resolved"
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/evidence_ref"
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direct_canonical_mutation_by_follow_up_candidate",
        "raw_transcript_included",
        "raw_skill_body_included",
        "raw_stdout_included",
        "raw_stderr_included",
        "provider_context_included",
        "live_process_handles_included",
        "local_filesystem_path_included"
      ],
      "properties": {
        "direct_canonical_mutation_by_follow_up_candidate": {
          "const": false
        },
        "raw_transcript_included": {
          "const": false
        },
        "raw_skill_body_included": {
          "const": false
        },
        "raw_stdout_included": {
          "const": false
        },
        "raw_stderr_included": {
          "const": false
        },
        "provider_context_included": {
          "const": false
        },
        "live_process_handles_included": {
          "const": false
        },
        "local_filesystem_path_included": {
          "const": false
        }
      }
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    }
  }
}
