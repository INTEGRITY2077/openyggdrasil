{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/live_e2e_physical_hermes_launch_attempt.v1.schema.json",
  "title": "openyggdrasil Live E2E Physical Hermes Launch Attempt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "run_id",
    "provider_name",
    "provider_profile",
    "provider_session_id",
    "safe_bundle_ref",
    "precondition_probe_id",
    "preconditions_ready",
    "launcher_decision",
    "command",
    "runner_invoked",
    "exit_code",
    "safe_artifact_refs",
    "raw_transcript_included",
    "may_claim_live_ready",
    "may_claim_91_percent_readiness",
    "claim_scope",
    "reason_codes",
    "checked_at"
  ],
  "properties": {
    "schema_version": {
      "const": "live_e2e_physical_hermes_launch_attempt.v1"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "provider_name": {
      "const": "hermes"
    },
    "provider_profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "provider_session_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        {
          "type": "null"
        }
      ]
    },
    "safe_bundle_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "precondition_probe_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "preconditions_ready": {
      "type": "boolean"
    },
    "launcher_decision": {
      "type": "string",
      "enum": [
        "typed_unavailable_not_started",
        "physical_hermes_process_completed",
        "physical_hermes_process_failed"
      ]
    },
    "command": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "runner_invoked": {
      "type": "boolean"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "safe_artifact_refs": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "raw_transcript_included": {
      "const": false
    },
    "may_claim_live_ready": {
      "const": false
    },
    "may_claim_91_percent_readiness": {
      "const": false
    },
    "claim_scope": {
      "type": "string",
      "enum": [
        "preflight_blocked_no_physical_execution",
        "physical_launcher_attempt_only"
      ]
    },
    "reason_codes": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "pattern": "^[A-Za-z0-9._:-]+$"
      }
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
