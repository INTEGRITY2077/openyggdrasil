#!/usr/bin/env python3
"""
ygg — openyggdrasil Operator Session Manager

계약:
  OP 홀수 = Producer (생산), OP 짝수 = Consumer (소비)
  1 Provider = 1 Producer + 1 Consumer = OP 페어 1쌍

Usage:
  ygg spawn [provider]          # 빈 OP 번호 자동 할당, 페어 생성
  ygg list                       # 모든 OP 세션 목록
  ygg attach <OP>               # live view 접속
  ygg release <OP>              # 세션 해제
  ygg status <OP>               # 단일 세션 상태

Registry: ~/.yggdrasil/registry.json
Sessions:  ~/.yggdrasil/sessions/OP{N}/
"""
import json
import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

REGISTRY_DIR = Path.home() / ".yggdrasil"
REGISTRY_FILE = REGISTRY_DIR / "registry.json"
SESSIONS_DIR = REGISTRY_DIR / "sessions"
REPO = Path("/mnt/d/0_PROJECT/openyggdrasil")


def _load_registry() -> dict:
    if not REGISTRY_FILE.exists():
        return {}
    return json.loads(REGISTRY_FILE.read_text())


def _save_registry(reg: dict) -> None:
    REGISTRY_DIR.mkdir(parents=True, exist_ok=True)
    REGISTRY_FILE.write_text(json.dumps(reg, indent=2, ensure_ascii=False))


def _next_pair(reg: dict) -> tuple[int, int]:
    """Find next available OP pair (odd=producer, even=consumer)."""
    used = {int(k.replace("OP", "")) for k in reg}
    n = 1
    while n in used or (n + 1) in used:
        n += 2
    return n, n + 1


def cmd_spawn(provider: str) -> None:
    reg = _load_registry()
    p, c = _next_pair(reg)
    vault = os.environ.get("OY_VAULT", str(REPO / "vault"))
    now = datetime.now(timezone.utc).isoformat()

    for num, otype in [(p, "producer"), (c, "consumer")]:
        op = f"OP{num}"
        session_dir = SESSIONS_DIR / op
        session_dir.mkdir(parents=True, exist_ok=True)
        reg[op] = {
            "provider": provider,
            "type": otype,
            "vault": vault,
            "created": now,
        }

    _save_registry(reg)
    print(f"OP{p} (producer) + OP{c} (consumer) allocated for {provider}")
    print(f"  vault: {vault}")


def cmd_list() -> None:
    reg = _load_registry()
    if not reg:
        print("(no sessions)")
        return
    for op in sorted(reg.keys(), key=lambda x: int(x.replace("OP", ""))):
        r = reg[op]
        print(f"  {op} [{r['provider']}] {r['type']}")


def cmd_attach(op: str) -> None:
    reg = _load_registry()
    if op not in reg:
        print(f"Error: {op} not found")
        sys.exit(1)
    r = reg[op]
    session_dir = SESSIONS_DIR / op
    mode = "produce" if r["type"] == "producer" else "consume"

    subprocess.run([
        sys.executable, str(REPO / "runtime" / "operator_entrypoint"),
        mode, "--mailbox", str(session_dir), "--vault", r["vault"],
    ], cwd=str(REPO), env={**os.environ, "PYTHONPATH": str(REPO)})


def cmd_release(op: str) -> None:
    reg = _load_registry()
    if op not in reg:
        print(f"Error: {op} not found")
        sys.exit(1)
    del reg[op]
    _save_registry(reg)
    print(f"{op} released")


def cmd_status(op: str) -> None:
    reg = _load_registry()
    if op not in reg:
        print(f"{op}: not registered")
        return
    r = reg[op]
    session_dir = SESSIONS_DIR / op
    receipt = session_dir / "receipts.jsonl"
    intents = session_dir / "intents.jsonl"
    print(f"{op}: {r['provider']} {r['type']}")
    print(f"  vault: {r['vault']}")
    print(f"  intents: {'yes' if intents.exists() else 'no'}")
    print(f"  receipts: {'yes' if receipt.exists() else 'no'}")


def main():
    if len(sys.argv) < 2:
        print("Usage: ygg <spawn|list|attach|release|status> [args]")
        sys.exit(1)

    cmd = sys.argv[1]
    if cmd == "spawn":
        provider = sys.argv[2] if len(sys.argv) > 2 else "hermes"
        cmd_spawn(provider)
    elif cmd == "list":
        cmd_list()
    elif cmd == "attach":
        cmd_attach(sys.argv[2])
    elif cmd == "release":
        cmd_release(sys.argv[2])
    elif cmd == "status":
        cmd_status(sys.argv[2] if len(sys.argv) > 2 else "OP1")
    else:
        print(f"Unknown: {cmd}")


if __name__ == "__main__":
    main()
