{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/log_delta.v1.schema.json",
  "title": "OpenYggdrasil Log Delta v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "delta_id",
    "transaction_ref",
    "timestamp",
    "operation",
    "message",
    "evidence_refs",
    "append_only",
    "append_only_log_validation_ref",
    "aftercare_request_or_ref_evidence",
    "bounded_to_single_transaction",
    "raw_provider_material_included",
    "skill_body_included",
    "credential_content_included",
    "portable_local_path_included",
    "portable_local_path_leakage_detected",
    "graphify_used_as_sot",
    "vector_embedding_used_as_canonical_placement",
    "broad_vault_scan_performed",
    "raw_stdout_included",
    "raw_stderr_included",
    "raw_tool_intermediates_included",
    "raw_provider_context_included",
    "live_process_handles_included",
    "untyped_scratch_files_included",
    "direct_aftercare_mutation_detected"
  ],
  "properties": {
    "schema_version": {
      "const": "log_delta.v1"
    },
    "delta_id": {
      "$ref": "#/$defs/identifier"
    },
    "transaction_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "operation": {
      "type": "string",
      "enum": [
        "ingest",
        "update",
        "reject",
        "typed_unavailable"
      ]
    },
    "message": {
      "$ref": "#/$defs/provider_safe_text"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/evidence_ref"
      }
    },
    "append_only": {
      "const": true
    },
    "append_only_log_validation_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "aftercare_request_or_ref_evidence": {
      "$ref": "#/$defs/safe_ref"
    },
    "bounded_to_single_transaction": {
      "const": true
    },
    "raw_provider_material_included": {
      "const": false
    },
    "skill_body_included": {
      "const": false
    },
    "credential_content_included": {
      "const": false
    },
    "portable_local_path_included": {
      "const": false
    },
    "portable_local_path_leakage_detected": {
      "const": false
    },
    "graphify_used_as_sot": {
      "const": false
    },
    "vector_embedding_used_as_canonical_placement": {
      "const": false
    },
    "broad_vault_scan_performed": {
      "const": false
    },
    "raw_stdout_included": {
      "const": false
    },
    "raw_stderr_included": {
      "const": false
    },
    "raw_tool_intermediates_included": {
      "const": false
    },
    "raw_provider_context_included": {
      "const": false
    },
    "live_process_handles_included": {
      "const": false
    },
    "untyped_scratch_files_included": {
      "const": false
    },
    "direct_aftercare_mutation_detected": {
      "const": false
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "safe_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^\\s]+$",
      "not": {
        "anyOf": [
          {
            "pattern": "^[Ff][Ii][Ll][Ee]://"
          },
          {
            "pattern": "^[A-Za-z]:"
          },
          {
            "pattern": "(?i)\\.skill\\.md"
          },
          {
            "pattern": "(?i)transcript\\.txt"
          },
          {
            "pattern": "(?i)credential"
          },
          {
            "pattern": "(?i)raw stdout"
          },
          {
            "pattern": "(?i)raw stderr"
          },
          {
            "pattern": "(?i)raw tool intermediate"
          },
          {
            "pattern": "(?i)raw provider context"
          },
          {
            "pattern": "(?i)live process handle"
          },
          {
            "pattern": "(?i)untyped scratch"
          }
        ]
      }
    },
    "provider_safe_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600,
      "not": {
        "anyOf": [
          {
            "pattern": "(?s)^---\\s*\\n.*name\\s*:"
          },
          {
            "pattern": "```"
          },
          {
            "pattern": "\\.skill\\.md"
          },
          {
            "pattern": "(?i)raw provider transcript"
          },
          {
            "pattern": "(?i)credential"
          },
          {
            "pattern": "(?i)raw stdout"
          },
          {
            "pattern": "(?i)raw stderr"
          },
          {
            "pattern": "(?i)raw tool intermediate"
          },
          {
            "pattern": "(?i)raw provider context"
          },
          {
            "pattern": "(?i)live process handle"
          },
          {
            "pattern": "(?i)untyped scratch"
          }
        ]
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "ref",
        "evidence_kind",
        "resolution_status"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/identifier"
        },
        "ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "evidence_kind": {
          "type": "string",
          "enum": [
            "production_request",
            "approved_routing_fact",
            "capability_lane_trace",
            "topic_episode_placement",
            "map_topography",
            "index_delta",
            "log_delta",
            "append_only_log_validation",
            "production_receipt",
            "ptc_egress_payload",
            "aftercare_request"
          ]
        },
        "resolution_status": {
          "const": "resolved"
        }
      }
    }
  }
}
