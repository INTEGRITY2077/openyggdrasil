{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/live_e2e_readiness_gate.v1.schema.json",
  "title": "OpenYggdrasil Live E2E Readiness Gate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "readiness_id",
    "phase_id",
    "gate_scope",
    "preconditions",
    "evidence_lanes",
    "required_precondition_ids",
    "satisfied_precondition_ids",
    "missing_precondition_ids",
    "typed_unavailable_precondition_ids",
    "invalid_precondition_ids",
    "required_evidence_lane_ids",
    "present_evidence_lane_ids",
    "missing_evidence_lane_ids",
    "typed_unavailable_evidence_lane_ids",
    "invalid_evidence_lane_ids",
    "non_live_evidence_lane_ids",
    "same_run_id",
    "live_execution_readiness",
    "evidence_chain_readiness",
    "readiness_state",
    "may_start_physical_live_probe",
    "may_claim_live_e2e_chain_complete",
    "may_claim_live_ready",
    "may_claim_91_percent_readiness",
    "raw_transcript_included",
    "rerun_condition",
    "evidence_required",
    "reason_codes",
    "checked_at"
  ],
  "properties": {
    "schema_version": {
      "const": "live_e2e_readiness_gate.v1"
    },
    "readiness_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "phase_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "gate_scope": {
      "const": "p9_physical_same_run_hermes_live_e2e_readiness"
    },
    "preconditions": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/precondition"
      }
    },
    "evidence_lanes": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/evidence_lane"
      }
    },
    "required_precondition_ids": {
      "$ref": "#/$defs/precondition_ids"
    },
    "satisfied_precondition_ids": {
      "$ref": "#/$defs/precondition_ids"
    },
    "missing_precondition_ids": {
      "$ref": "#/$defs/precondition_ids"
    },
    "typed_unavailable_precondition_ids": {
      "$ref": "#/$defs/precondition_ids"
    },
    "invalid_precondition_ids": {
      "$ref": "#/$defs/precondition_ids"
    },
    "required_evidence_lane_ids": {
      "$ref": "#/$defs/evidence_lane_ids"
    },
    "present_evidence_lane_ids": {
      "$ref": "#/$defs/evidence_lane_ids"
    },
    "missing_evidence_lane_ids": {
      "$ref": "#/$defs/evidence_lane_ids"
    },
    "typed_unavailable_evidence_lane_ids": {
      "$ref": "#/$defs/evidence_lane_ids"
    },
    "invalid_evidence_lane_ids": {
      "$ref": "#/$defs/evidence_lane_ids"
    },
    "non_live_evidence_lane_ids": {
      "$ref": "#/$defs/evidence_lane_ids"
    },
    "same_run_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "live_execution_readiness": {
      "type": "string",
      "enum": [
        "ready_for_physical_live_probe",
        "not_ready"
      ]
    },
    "evidence_chain_readiness": {
      "type": "string",
      "enum": [
        "same_run_evidence_complete",
        "not_ready"
      ]
    },
    "readiness_state": {
      "type": "string",
      "enum": [
        "ready_for_physical_live_probe_execution",
        "ready_for_live_e2e_report_review",
        "not_ready"
      ]
    },
    "may_start_physical_live_probe": {
      "type": "boolean"
    },
    "may_claim_live_e2e_chain_complete": {
      "type": "boolean"
    },
    "may_claim_live_ready": {
      "const": false
    },
    "may_claim_91_percent_readiness": {
      "const": false
    },
    "raw_transcript_included": {
      "const": false
    },
    "rerun_condition": {
      "type": "string",
      "enum": [
        "satisfy_live_e2e_preconditions",
        "execute_physical_same_run_hermes_live_e2e",
        "review_production_report_without_overclaim"
      ]
    },
    "evidence_required": {
      "type": "array",
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "pattern": "^[A-Za-z0-9._:-]+$"
      }
    },
    "reason_codes": {
      "type": "array",
      "maxItems": 48,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "pattern": "^[A-Za-z0-9._:-]+$"
      }
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precondition_id",
        "status",
        "source_kind",
        "artifact_ref",
        "reason_code",
        "safe_evidence_refs",
        "contains_raw_transcript"
      ],
      "properties": {
        "precondition_id": {
          "type": "string",
          "enum": [
            "run_lock_held",
            "hermes_binary_available",
            "provider_profile_available",
            "live_artifact_root_available",
            "safe_capture_policy_available",
            "raw_transcript_filter_enabled",
            "stale_decoy_probe_plan_available",
            "wsl2_bubblewrap_available",
            "schema_contracts_available"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "present",
            "typed_unavailable",
            "missing",
            "invalid"
          ]
        },
        "source_kind": {
          "$ref": "#/$defs/source_kind"
        },
        "artifact_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "reason_code": {
          "$ref": "#/$defs/nullable_reason"
        },
        "safe_evidence_refs": {
          "$ref": "#/$defs/safe_evidence_refs"
        },
        "contains_raw_transcript": {
          "const": false
        }
      }
    },
    "evidence_lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_id",
        "status",
        "artifact_ref",
        "sha256",
        "typed_unavailable_reason",
        "source_kind",
        "same_run_id",
        "safe_evidence_refs",
        "contains_raw_transcript",
        "fixture_only",
        "historical_only"
      ],
      "properties": {
        "lane_id": {
          "type": "string",
          "enum": [
            "e2e1_physical_session",
            "e2e2_knowledge_forest_delta",
            "e2e3_graphify_snapshot",
            "e2e4_mailbox_consumption",
            "same_run_hermes_live_witness",
            "ptc_runtime_trace",
            "e2e5b_reasoning_lease_isolation",
            "e2e6a_production_lineage",
            "e2e6_production_report_rebuild"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "present",
            "typed_unavailable",
            "missing",
            "invalid"
          ]
        },
        "artifact_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "typed_unavailable_reason": {
          "$ref": "#/$defs/nullable_reason"
        },
        "source_kind": {
          "$ref": "#/$defs/source_kind"
        },
        "same_run_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9._:-]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "safe_evidence_refs": {
          "$ref": "#/$defs/safe_evidence_refs"
        },
        "contains_raw_transcript": {
          "const": false
        },
        "fixture_only": {
          "type": "boolean"
        },
        "historical_only": {
          "type": "boolean"
        }
      }
    },
    "precondition_ids": {
      "type": "array",
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "run_lock_held",
          "hermes_binary_available",
          "provider_profile_available",
          "live_artifact_root_available",
          "safe_capture_policy_available",
          "raw_transcript_filter_enabled",
          "stale_decoy_probe_plan_available",
          "wsl2_bubblewrap_available",
          "schema_contracts_available"
        ]
      }
    },
    "evidence_lane_ids": {
      "type": "array",
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "e2e1_physical_session",
          "e2e2_knowledge_forest_delta",
          "e2e3_graphify_snapshot",
          "e2e4_mailbox_consumption",
          "same_run_hermes_live_witness",
          "ptc_runtime_trace",
          "e2e5b_reasoning_lease_isolation",
          "e2e6a_production_lineage",
          "e2e6_production_report_rebuild"
        ]
      }
    },
    "nullable_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "safe_evidence_refs": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "source_kind": {
      "type": "string",
      "enum": [
        "runtime_check",
        "operator_declared",
        "contract_surface",
        "physical_live_artifact",
        "contract_artifact",
        "same_run_witness",
        "real_wsl_trace",
        "production_report",
        "typed_unavailable",
        "not_supplied",
        "fixture_only",
        "historical_witness"
      ]
    }
  }
}
