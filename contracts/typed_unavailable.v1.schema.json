{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/typed_unavailable.v1.schema.json",
  "title": "openyggdrasil Typed Unavailable v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "unavailable_ref",
    "created_at",
    "reason_code",
    "blocked_stage",
    "missing_or_rejected_refs",
    "raw_provider_material_included",
    "skill_body_included",
    "portable_local_path_included",
    "fabricated_answer",
    "no_overclaim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "typed_unavailable.v1"
    },
    "unavailable_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason_code": {
      "type": "string",
      "enum": [
        "missing_independent_verification",
        "unresolved_evidence_ref",
        "stale_or_decoy_evidence",
        "raw_provider_material_detected",
        "raw_skill_body_detected",
        "unsafe_local_path_detected",
        "graphify_hint_not_sot",
        "producer_receipt_missing",
        "consumer_ingress_blocked"
      ]
    },
    "blocked_stage": {
      "type": "string",
      "enum": [
        "independent_verification_gate",
        "evidence_resolution",
        "recall_support_bundle",
        "answer_receipt",
        "raw_material_scan"
      ]
    },
    "missing_or_rejected_refs": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/rejected_ref"
      }
    },
    "raw_provider_material_included": {
      "const": false
    },
    "skill_body_included": {
      "const": false
    },
    "portable_local_path_included": {
      "const": false
    },
    "fabricated_answer": {
      "const": false
    },
    "no_overclaim_boundary": {
      "$ref": "#/$defs/no_overclaim_boundary"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "safe_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^\\s]+$",
      "not": {
        "anyOf": [
          {
            "pattern": "^[Ff][Ii][Ll][Ee]://"
          },
          {
            "pattern": "^[A-Za-z]:"
          },
          {
            "pattern": "(?i)\\.skill\\.md"
          },
          {
            "pattern": "(?i)transcript\\.txt"
          }
        ]
      }
    },
    "rejected_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "reason_code",
        "rejection_kind"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "reason_code": {
          "$ref": "#/$defs/identifier"
        },
        "rejection_kind": {
          "type": "string",
          "enum": [
            "missing",
            "unresolved",
            "stale",
            "superseded",
            "decoy",
            "graphify_non_sot",
            "unsafe_material"
          ]
        }
      }
    },
    "no_overclaim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_readiness_claimed",
        "production_readiness_claimed",
        "reasoning_lease_solved_claimed",
        "public_runtime_integration_complete_claimed",
        "readiness_91_percent_claimed"
      ],
      "properties": {
        "live_readiness_claimed": {
          "const": false
        },
        "production_readiness_claimed": {
          "const": false
        },
        "reasoning_lease_solved_claimed": {
          "const": false
        },
        "public_runtime_integration_complete_claimed": {
          "const": false
        },
        "readiness_91_percent_claimed": {
          "const": false
        }
      }
    }
  }
}
