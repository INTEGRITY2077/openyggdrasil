{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/tree_ring_snapshot.v1.schema.json",
  "title": "openyggdrasil Tree Ring Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "snapshot_id",
    "snapshot_request_id",
    "snapshot_status",
    "unavailable_condition",
    "ring_id",
    "ring_ref",
    "snapshot_ref",
    "point_in_time_ref",
    "basis_refs",
    "unsafe_basis_ref_count",
    "safe_portable_refs",
    "reason_codes",
    "ptc_callable",
    "runtime_owner",
    "point_in_time_stub",
    "historical_read_complete",
    "historical_ring_snapshot_read_capability_claimed",
    "raw_transcript_included",
    "raw_provider_material_included",
    "skill_body_included",
    "provider_credential_profile_included",
    "portable_local_path_included",
    "live_readiness_claimed",
    "production_readiness_claimed",
    "public_runtime_integration_complete_claimed",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "tree_ring_snapshot.v1"
    },
    "snapshot_id": {
      "$ref": "#/$defs/identifier"
    },
    "snapshot_request_id": {
      "$ref": "#/$defs/identifier"
    },
    "snapshot_status": {
      "type": "string",
      "enum": [
        "snapshot_stubbed",
        "typed_unavailable"
      ]
    },
    "unavailable_condition": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 180
    },
    "ring_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 2,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{1,127}$",
          "not": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z]:"
              },
              {
                "pattern": "(?i)\\.skill\\.md"
              },
              {
                "pattern": "(?i)credential"
              },
              {
                "pattern": "(?i)transcript"
              }
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "ring_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/safe_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshot_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/safe_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "point_in_time_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/safe_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "basis_refs": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/safe_ref"
      }
    },
    "unsafe_basis_ref_count": {
      "type": "integer",
      "minimum": 0
    },
    "safe_portable_refs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/safe_ref"
      }
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "ptc_callable": {
      "const": true
    },
    "runtime_owner": {
      "const": "runtime/memory/tree_ring_snapshot.py"
    },
    "point_in_time_stub": {
      "const": true
    },
    "historical_read_complete": {
      "const": false
    },
    "historical_ring_snapshot_read_capability_claimed": {
      "const": false
    },
    "raw_transcript_included": {
      "const": false
    },
    "raw_provider_material_included": {
      "const": false
    },
    "skill_body_included": {
      "const": false
    },
    "provider_credential_profile_included": {
      "const": false
    },
    "portable_local_path_included": {
      "const": false
    },
    "live_readiness_claimed": {
      "const": false
    },
    "production_readiness_claimed": {
      "const": false
    },
    "public_runtime_integration_complete_claimed": {
      "const": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "safe_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 700,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^\\\\\\s]+$",
      "not": {
        "anyOf": [
          {
            "pattern": "^[Ff][Ii][Ll][Ee]://"
          },
          {
            "pattern": "^[A-Za-z]:"
          },
          {
            "pattern": "(?i)\\.skill\\.md"
          },
          {
            "pattern": "(?i)credential"
          },
          {
            "pattern": "(?i)transcript"
          }
        ]
      }
    }
  }
}
