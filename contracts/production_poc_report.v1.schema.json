{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/production_poc_report.v1.schema.json",
  "title": "openyggdrasil Production POC Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "decision",
    "readiness_state",
    "scenario_count",
    "green_scenario_count",
    "not_implemented_scenario_count",
    "must_pass_safety_cases_pass_rate",
    "must_pass_memory_visibility_cases_pass_rate",
    "quality_cases_pass_rate",
    "raw_provider_session_copy_count",
    "public_forbidden_tracked_path_count",
    "doc_or_ignored_artifact_dependency_count",
    "history_core_public_track_hygiene_state",
    "live_provider_readiness",
    "live_provider_rerun_condition",
    "live_provider_evidence_required",
    "ux_trust_decision",
    "foreground_live_comparison_decision",
    "evidence_lineage_id",
    "evidence_lineage_status",
    "evidence_lineage_readiness",
    "evidence_lineage_required_lane_ids",
    "evidence_lineage_present_lane_ids",
    "evidence_lineage_missing_lane_ids",
    "evidence_lineage_validation_error",
    "same_run_witness_decision",
    "same_run_witness_readiness",
    "same_run_witness_claim_scope",
    "same_run_witness_validation_error",
    "fixture_only_artifacts_present",
    "may_claim_91_percent_readiness",
    "failing_metrics",
    "residual_risks",
    "checked_at"
  ],
  "properties": {
    "schema_version": {
      "const": "production_poc_report.v1"
    },
    "report_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "decision": {
      "type": "string",
      "enum": [
        "green_passed",
        "red_captured"
      ]
    },
    "readiness_state": {
      "type": "string",
      "enum": [
        "ready",
        "not_ready",
        "blocked"
      ]
    },
    "scenario_count": {
      "type": "integer",
      "minimum": 0
    },
    "green_scenario_count": {
      "type": "integer",
      "minimum": 0
    },
    "not_implemented_scenario_count": {
      "type": "integer",
      "minimum": 0
    },
    "must_pass_safety_cases_pass_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "must_pass_memory_visibility_cases_pass_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "quality_cases_pass_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "raw_provider_session_copy_count": {
      "type": "integer",
      "minimum": 0
    },
    "public_forbidden_tracked_path_count": {
      "type": "integer",
      "minimum": 0
    },
    "doc_or_ignored_artifact_dependency_count": {
      "type": "integer",
      "minimum": 0
    },
    "history_core_public_track_hygiene_state": {
      "type": "string",
      "enum": [
        "sanitized_verified",
        "blocked_by_existing_tracked_leakage",
        "not_checked"
      ]
    },
    "live_provider_readiness": {
      "type": "string",
      "enum": [
        "live_proven",
        "typed_unavailable_not_live_proven",
        "not_implemented",
        "not_claimable"
      ]
    },
    "live_provider_rerun_condition": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "live_provider_evidence_required": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "^[A-Za-z0-9._:-]+$"
      }
    },
    "ux_trust_decision": {
      "type": "string",
      "enum": [
        "green_passed",
        "red_captured"
      ]
    },
    "foreground_live_comparison_decision": {
      "type": "string",
      "enum": [
        "green_passed",
        "red_captured"
      ]
    },
    "evidence_lineage_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 128
    },
    "evidence_lineage_status": {
      "type": "string",
      "enum": [
        "complete_minimum_lineage",
        "incomplete_minimum_lineage",
        "typed_unavailable",
        "not_supplied",
        "invalid"
      ]
    },
    "evidence_lineage_readiness": {
      "type": "string",
      "enum": [
        "ready_for_report_rebuild",
        "not_ready"
      ]
    },
    "evidence_lineage_required_lane_ids": {
      "$ref": "#/$defs/e2e_lineage_lane_ids"
    },
    "evidence_lineage_present_lane_ids": {
      "$ref": "#/$defs/e2e_lineage_lane_ids"
    },
    "evidence_lineage_missing_lane_ids": {
      "$ref": "#/$defs/e2e_lineage_lane_ids"
    },
    "evidence_lineage_validation_error": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 500
    },
    "same_run_witness_decision": {
      "type": "string",
      "enum": [
        "live_equivalent_ready_for_e2e5",
        "historical_session_witness_not_live_equivalent",
        "typed_unavailable_not_live_proven",
        "not_supplied",
        "invalid"
      ]
    },
    "same_run_witness_readiness": {
      "type": "string",
      "enum": [
        "ready_for_e2e5",
        "not_ready"
      ]
    },
    "same_run_witness_claim_scope": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "same_run_witness_validation_error": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 500
    },
    "fixture_only_artifacts_present": {
      "type": "boolean"
    },
    "may_claim_91_percent_readiness": {
      "type": "boolean"
    },
    "failing_metrics": {
      "type": "array",
      "maxItems": 40,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "^[A-Za-z0-9._:-]+$"
      }
    },
    "residual_risks": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "e2e_lineage_lane_ids": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "e2e1_physical_session",
          "e2e2_knowledge_forest_delta",
          "e2e3_graphify_snapshot",
          "e2e4_mailbox_consumption",
          "e2e5b_reasoning_lease_isolation"
        ]
      }
    }
  }
}
