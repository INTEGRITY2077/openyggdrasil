{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/support_bundle.v1.schema.json",
  "title": "OpenYggdrasil Support Bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_packet_id",
    "source_packet_type",
    "query_text",
    "facts",
    "source_paths"
  ],
  "allOf": [
    {
      "anyOf": [
        {
          "properties": {
            "source_paths": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "canonical_note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "canonical_note"
          ]
        },
        {
          "properties": {
            "provenance_note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "provenance_note"
          ]
        },
        {
          "properties": {
            "pathfinder_bundle": {
              "type": "object",
              "required": [
                "source_paths"
              ],
              "properties": {
                "source_paths": {
                  "minItems": 1
                }
              }
            }
          },
          "required": [
            "pathfinder_bundle"
          ]
        }
      ]
    }
  ],
  "properties": {
    "schema_version": {
      "const": "support_bundle.v1"
    },
    "source_packet_id": {
      "type": "string",
      "minLength": 1
    },
    "source_packet_type": {
      "type": "string",
      "minLength": 1
    },
    "query_text": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": [
        "string",
        "null"
      ]
    },
    "human_summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "not": {
              "pattern": "(?s)^---\\s*\\n.*name\\s*:"
            }
          }
        ]
      }
    },
    "routing_receipts": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/hermes_routing_receipt"
      }
    },
    "source_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "graph_freshness": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 0
        },
        {
          "$ref": "#/$defs/graph_freshness"
        }
      ]
    },
    "pathfinder_bundle": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "maxProperties": 0
        },
        {
          "$ref": "#/$defs/pathfinder_bundle"
        },
        {
          "$ref": "#/$defs/pathfinder_source_bundle"
        }
      ]
    },
    "decision_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "mailbox_location": {
      "type": [
        "string",
        "null"
      ]
    },
    "proof_token": {
      "type": [
        "string",
        "null"
      ]
    },
    "rationale_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "canonical_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "community_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "provenance_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "community_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "graph_freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reasons",
        "graph_query_used"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "fresh",
            "stale",
            "missing",
            "unknown"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "graph_query_used": {
          "type": "boolean"
        }
      }
    },
    "pathfinder_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "query_text",
        "anchor_type",
        "anchor_id",
        "topic_id",
        "episode_ids",
        "claim_ids",
        "page_ids",
        "source_paths",
        "support_facts",
        "bundle_mode",
        "generated_at"
      ],
      "properties": {
        "schema_version": {
          "const": "pathfinder.v1"
        },
        "query_text": {
          "type": "string",
          "minLength": 1
        },
        "anchor_type": {
          "type": "string",
          "enum": [
            "topic",
            "none"
          ]
        },
        "anchor_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "topic_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "anchor_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "episode_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "page_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "support_facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bundle_mode": {
          "type": "string",
          "enum": [
            "topic-page-latest-episodes",
            "topic-page-latest-episodes-with-semantic-edges",
            "topic-page-recent-origin",
            "unanchored"
          ]
        },
        "generated_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pathfinder_source_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_paths"
      ],
      "properties": {
        "schema_version": {
          "const": "pathfinder.v1"
        },
        "source_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "hermes_routing_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "receipt_id",
        "route_id",
        "approved_routing_fact_ref",
        "query_ref",
        "support_bundle_ref",
        "ptc_trace_ref",
        "runtime_authoritative",
        "approved_effort",
        "lease_group",
        "provider_route_summary",
        "selected_memory_refs",
        "rejected_memory_refs",
        "evidence_refs",
        "skill_body_included",
        "raw_provider_material_included",
        "portable_local_path_included",
        "advisory_metadata_lowered_effort",
        "live_readiness_claimed",
        "production_readiness_claimed",
        "reasoning_lease_solved_claimed",
        "target_readiness_claimed",
        "reason_codes",
        "generated_at"
      ],
      "properties": {
        "schema_version": {
          "const": "hermes_routing_receipt.v1"
        },
        "receipt_id": {
          "$ref": "#/$defs/identifier"
        },
        "route_id": {
          "$ref": "#/$defs/identifier"
        },
        "approved_routing_fact_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "query_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "support_bundle_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "ptc_trace_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "runtime_authoritative": {
          "const": true
        },
        "approved_effort": {
          "$ref": "#/$defs/effort_level"
        },
        "lease_group": {
          "$ref": "#/$defs/lease_group"
        },
        "provider_route_summary": {
          "$ref": "#/$defs/provider_safe_text"
        },
        "selected_memory_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/memory_ref"
          }
        },
        "rejected_memory_refs": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/memory_ref"
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/evidence_ref"
          }
        },
        "skill_body_included": {
          "const": false
        },
        "raw_provider_material_included": {
          "const": false
        },
        "portable_local_path_included": {
          "const": false
        },
        "advisory_metadata_lowered_effort": {
          "const": false
        },
        "live_readiness_claimed": {
          "const": false
        },
        "production_readiness_claimed": {
          "const": false
        },
        "reasoning_lease_solved_claimed": {
          "const": false
        },
        "target_readiness_claimed": {
          "const": false
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "safe_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^\\s]+$",
      "not": {
        "anyOf": [
          {
            "pattern": "^[Ff][Ii][Ll][Ee]://"
          },
          {
            "pattern": "^[A-Za-z]:"
          }
        ]
      }
    },
    "provider_safe_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600,
      "not": {
        "anyOf": [
          {
            "pattern": "(?s)^---\\s*\\n.*name\\s*:"
          },
          {
            "pattern": "```"
          },
          {
            "pattern": "\\.skill\\.md"
          },
          {
            "pattern": "<INSTRUCTIONS>"
          }
        ]
      }
    },
    "effort_level": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "lease_group": {
      "type": "string",
      "enum": [
        "deep_reasoning",
        "semantic_routing",
        "deterministic"
      ]
    },
    "memory_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "role",
        "reason_code"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "role": {
          "$ref": "#/$defs/identifier"
        },
        "reason_code": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "ref",
        "evidence_kind",
        "pointer_accounting_key"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/identifier"
        },
        "ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "evidence_kind": {
          "type": "string",
          "enum": [
            "approved_routing_fact",
            "pathfinder_trace",
            "ptc_trace",
            "support_bundle",
            "route_decision"
          ]
        },
        "pointer_accounting_key": {
          "$ref": "#/$defs/identifier"
        }
      }
    }
  }
}
