{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/programmatic_tool_runtime_trace.v1.schema.json",
  "title": "OpenYggdrasil Programmatic Tool Runtime Trace v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "runtime_mode",
    "query_text",
    "decision",
    "claim_scope",
    "same_run_context_status",
    "same_run_context",
    "policy",
    "capability_registry",
    "program",
    "capability_calls",
    "final_result",
    "gates",
    "reason_codes",
    "generated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "programmatic_tool_runtime_trace.v1"
    },
    "trace_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "runtime_mode": {
      "const": "bounded_programmatic_tool_plan"
    },
    "query_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "decision": {
      "type": "string",
      "enum": [
        "completed"
      ]
    },
    "claim_scope": {
      "type": "string",
      "enum": [
        "ptc_contract_poc_not_live_provider_readiness",
        "ptc_same_run_context_accepted_not_live_readiness"
      ]
    },
    "same_run_context_status": {
      "type": "string",
      "enum": [
        "absent",
        "accepted"
      ]
    },
    "same_run_context": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "same_run_id",
            "same_run_witness_ref",
            "same_run_source_kind",
            "evidence_chain_status",
            "source_authority"
          ],
          "properties": {
            "same_run_id": {
              "$ref": "#/$defs/identifier"
            },
            "same_run_witness_ref": {
              "$ref": "#/$defs/evidence_ref"
            },
            "same_run_source_kind": {
              "const": "physical_live_same_run"
            },
            "evidence_chain_status": {
              "const": "upstream_verified"
            },
            "source_authority": {
              "$ref": "#/$defs/identifier"
            },
            "mailbox_delivery_ref": {
              "$ref": "#/$defs/evidence_ref"
            },
            "hermes_consumption_ref": {
              "$ref": "#/$defs/evidence_ref"
            },
            "ptc_trace_ref": {
              "$ref": "#/$defs/evidence_ref"
            },
            "bubblewrap_trace_ref": {
              "$ref": "#/$defs/evidence_ref"
            }
          }
        }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_source_execution",
        "allow_write_capabilities",
        "sandbox_claim",
        "max_steps"
      ],
      "properties": {
        "program_source_execution": {
          "const": "disabled"
        },
        "allow_write_capabilities": {
          "const": false
        },
        "sandbox_claim": {
          "type": "string",
          "enum": [
            "not_claimed_read_only_contract"
          ]
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      }
    },
    "capability_registry": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability_id",
          "read_only",
          "input_contract",
          "output_kind"
        ],
        "properties": {
          "capability_id": {
            "$ref": "#/$defs/identifier"
          },
          "read_only": {
            "const": true
          },
          "input_contract": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/identifier"
            }
          },
          "output_kind": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "program": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "capability_id",
          "input_binding_keys"
        ],
        "properties": {
          "step_id": {
            "$ref": "#/$defs/identifier"
          },
          "capability_id": {
            "$ref": "#/$defs/identifier"
          },
          "input_binding_keys": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      }
    },
    "capability_calls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "capability_id",
          "status",
          "read_only",
          "input_keys",
          "output_kind",
          "result_sha256",
          "result_ref"
        ],
        "properties": {
          "step_id": {
            "$ref": "#/$defs/identifier"
          },
          "capability_id": {
            "$ref": "#/$defs/identifier"
          },
          "status": {
            "const": "completed"
          },
          "read_only": {
            "const": true
          },
          "input_keys": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/identifier"
            }
          },
          "output_kind": {
            "$ref": "#/$defs/identifier"
          },
          "result_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "result_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          }
        }
      }
    },
    "final_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "final_step_id",
        "result_kind",
        "result_sha256",
        "result_ref"
      ],
      "properties": {
        "final_step_id": {
          "$ref": "#/$defs/identifier"
        },
        "result_kind": {
          "const": "pathfinder_bundle"
        },
        "result_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "result_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknown_capability_blocked",
        "input_validation_enforced",
        "permission_policy_enforced",
        "final_result_validated",
        "dynamic_code_execution_allowed",
        "private_source_copied",
        "graph_output_treated_as_sot",
        "live_provider_readiness_claimed",
        "same_run_context_upstream_verified",
        "same_run_context_fabricated",
        "historical_fixture_or_contract_only_trace_accepted"
      ],
      "properties": {
        "unknown_capability_blocked": {
          "const": true
        },
        "input_validation_enforced": {
          "const": true
        },
        "permission_policy_enforced": {
          "const": true
        },
        "final_result_validated": {
          "const": true
        },
        "dynamic_code_execution_allowed": {
          "const": false
        },
        "private_source_copied": {
          "const": false
        },
        "graph_output_treated_as_sot": {
          "const": false
        },
        "live_provider_readiness_claimed": {
          "const": false
        },
        "same_run_context_upstream_verified": {
          "type": "boolean"
        },
        "same_run_context_fabricated": {
          "const": false
        },
        "historical_fixture_or_contract_only_trace_accepted": {
          "const": false
        }
      }
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://.+$"
    }
  }
}
