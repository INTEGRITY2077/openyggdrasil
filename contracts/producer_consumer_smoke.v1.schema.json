{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/producer_consumer_smoke.v1.schema.json",
  "title": "openyggdrasil Producer Consumer Smoke v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "smoke_id",
    "smoke_request_id",
    "smoke_status",
    "unavailable_condition",
    "producer_request_ref",
    "production_receipt_ref",
    "support_bundle_ref",
    "consumer_menu_ref",
    "tree_ring_snapshot_ref",
    "skill_metadata_ref",
    "provider_receipt_consumer_ref",
    "smoke_ref",
    "smoke_edges",
    "safe_portable_refs",
    "reason_codes",
    "ptc_callable",
    "runtime_owner",
    "transition_prep_only",
    "typed_refs_only",
    "raw_transcript_included",
    "raw_provider_material_included",
    "skill_body_included",
    "provider_credential_profile_included",
    "portable_local_path_included",
    "consumer_ux_completion_claimed",
    "public_runtime_integration_complete_claimed",
    "production_readiness_claimed",
    "live_readiness_claimed",
    "reasoning_lease_solved_claimed",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "producer_consumer_smoke.v1"
    },
    "smoke_id": {
      "$ref": "#/$defs/identifier"
    },
    "smoke_request_id": {
      "$ref": "#/$defs/identifier"
    },
    "smoke_status": {
      "type": "string",
      "enum": [
        "smoke_built",
        "typed_unavailable"
      ]
    },
    "unavailable_condition": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 180
    },
    "producer_request_ref": {
      "$ref": "#/$defs/nullable_safe_ref"
    },
    "production_receipt_ref": {
      "$ref": "#/$defs/nullable_safe_ref"
    },
    "support_bundle_ref": {
      "$ref": "#/$defs/nullable_safe_ref"
    },
    "consumer_menu_ref": {
      "$ref": "#/$defs/nullable_safe_ref"
    },
    "tree_ring_snapshot_ref": {
      "$ref": "#/$defs/nullable_safe_ref"
    },
    "skill_metadata_ref": {
      "$ref": "#/$defs/nullable_safe_ref"
    },
    "provider_receipt_consumer_ref": {
      "$ref": "#/$defs/nullable_safe_ref"
    },
    "smoke_ref": {
      "$ref": "#/$defs/nullable_safe_ref"
    },
    "smoke_edges": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/smoke_edge"
      }
    },
    "safe_portable_refs": {
      "type": "array",
      "maxItems": 48,
      "items": {
        "$ref": "#/$defs/safe_ref"
      }
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "ptc_callable": {
      "const": true
    },
    "runtime_owner": {
      "const": "runtime/pipeline/producer_consumer_smoke.py"
    },
    "transition_prep_only": {
      "const": true
    },
    "typed_refs_only": {
      "const": true
    },
    "raw_transcript_included": {
      "const": false
    },
    "raw_provider_material_included": {
      "const": false
    },
    "skill_body_included": {
      "const": false
    },
    "provider_credential_profile_included": {
      "const": false
    },
    "portable_local_path_included": {
      "const": false
    },
    "consumer_ux_completion_claimed": {
      "const": false
    },
    "public_runtime_integration_complete_claimed": {
      "const": false
    },
    "production_readiness_claimed": {
      "const": false
    },
    "live_readiness_claimed": {
      "const": false
    },
    "reasoning_lease_solved_claimed": {
      "const": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "nullable_safe_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/safe_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "safe_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 700,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^\\\\\\s]+$",
      "not": {
        "anyOf": [
          {
            "pattern": "^[Ff][Ii][Ll][Ee]://"
          },
          {
            "pattern": "^[A-Za-z]:"
          },
          {
            "pattern": "(?i)\\.skill\\.md"
          },
          {
            "pattern": "(?i)credential"
          },
          {
            "pattern": "(?i)transcript"
          }
        ]
      }
    },
    "smoke_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_kind",
        "from_ref",
        "to_ref",
        "reason_code"
      ],
      "properties": {
        "edge_kind": {
          "type": "string",
          "enum": [
            "producer_request_to_receipt",
            "receipt_to_support_bundle",
            "support_bundle_to_consumer_menu"
          ]
        },
        "from_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "to_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "reason_code": {
          "$ref": "#/$defs/identifier"
        }
      }
    }
  }
}
