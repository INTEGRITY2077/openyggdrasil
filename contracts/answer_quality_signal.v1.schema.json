{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/answer_quality_signal.v1.schema.json",
  "title": "openyggdrasil Answer Quality Signal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "quality_signal_id",
    "created_at",
    "answer_ref",
    "consumer_receipt_ref",
    "scorecard_ref",
    "quality_claims",
    "evidence_refs",
    "guards",
    "no_overclaim_boundary",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {
      "const": "answer_quality_signal.v1"
    },
    "quality_signal_id": {
      "$ref": "#/$defs/identifier"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "answer_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "consumer_receipt_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "scorecard_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "quality_claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/quality_claim"
      }
    },
    "evidence_refs": {
      "$ref": "#/$defs/evidence_refs"
    },
    "guards": {
      "$ref": "#/$defs/guards"
    },
    "no_overclaim_boundary": {
      "$ref": "#/$defs/no_overclaim_boundary"
    },
    "reason_codes": {
      "$ref": "#/$defs/reason_codes"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "safe_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^\\s]+$",
      "not": {
        "anyOf": [
          {
            "pattern": "^[Ff][Ii][Ll][Ee]://"
          },
          {
            "pattern": "^[A-Za-z]:"
          },
          {
            "pattern": "(?i)credential"
          },
          {
            "pattern": "(?i)raw[-_ ]?(transcript|provider|stdout|stderr)"
          }
        ]
      }
    },
    "provider_safe_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600,
      "not": {
        "anyOf": [
          {
            "pattern": "(?i)raw provider context"
          },
          {
            "pattern": "(?i)raw transcript"
          },
          {
            "pattern": "(?i)raw skill body"
          },
          {
            "pattern": "(?i)raw stdout"
          },
          {
            "pattern": "(?i)raw stderr"
          },
          {
            "pattern": "(?i)live process handle"
          },
          {
            "pattern": "(?i)credential"
          },
          {
            "pattern": "[A-Za-z]:\\\\"
          },
          {
            "pattern": "^[Ff][Ii][Ll][Ee]://"
          }
        ]
      }
    },
    "quality_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim_kind",
        "claim_text",
        "score",
        "scorecard_ref",
        "evidence_refs"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/identifier"
        },
        "claim_kind": {
          "type": "string",
          "enum": [
            "grounding",
            "relevance",
            "completeness",
            "conflict_handling",
            "safety",
            "graph_hint_helped_answer_quality"
          ]
        },
        "claim_text": {
          "$ref": "#/$defs/provider_safe_text"
        },
        "score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "scorecard_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "graph_hint_helped_answer_quality_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "claim_kind": {
                "const": "graph_hint_helped_answer_quality"
              }
            },
            "required": [
              "claim_kind"
            ]
          },
          "then": {
            "required": [
              "graph_hint_helped_answer_quality_ref",
              "scorecard_ref",
              "evidence_refs"
            ]
          }
        }
      ]
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "ref",
        "evidence_kind",
        "resolution_status"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/identifier"
        },
        "ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "evidence_kind": {
          "type": "string",
          "enum": [
            "consumer_receipt",
            "producer_receipt",
            "scorecard",
            "answer_receipt",
            "support_bundle",
            "graph_non_sot_hint",
            "graph_structure_quality_gate"
          ]
        },
        "resolution_status": {
          "const": "resolved"
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/evidence_ref"
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "answer_quality_without_evidence_refs",
        "missing_or_unresolved_evidence_refs_passed",
        "graph_hint_helped_answer_quality_without_scorecard_evidence",
        "raw_transcript_included",
        "raw_skill_body_included",
        "raw_stdout_included",
        "raw_stderr_included",
        "provider_context_included",
        "live_process_handles_included",
        "local_filesystem_path_included"
      ],
      "properties": {
        "answer_quality_without_evidence_refs": {
          "const": false
        },
        "missing_or_unresolved_evidence_refs_passed": {
          "const": false
        },
        "graph_hint_helped_answer_quality_without_scorecard_evidence": {
          "const": false
        },
        "raw_transcript_included": {
          "const": false
        },
        "raw_skill_body_included": {
          "const": false
        },
        "raw_stdout_included": {
          "const": false
        },
        "raw_stderr_included": {
          "const": false
        },
        "provider_context_included": {
          "const": false
        },
        "live_process_handles_included": {
          "const": false
        },
        "local_filesystem_path_included": {
          "const": false
        }
      }
    },
    "no_overclaim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hermes_answer_quality_claimed",
        "production_readiness_claimed",
        "readiness_91_percent_claimed"
      ],
      "properties": {
        "hermes_answer_quality_claimed": {
          "const": false
        },
        "production_readiness_claimed": {
          "const": false
        },
        "readiness_91_percent_claimed": {
          "const": false
        }
      }
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    }
  }
}
