{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/community_growth_event.v1.schema.json",
  "title": "Community Growth Event v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "growth_event_id",
    "community_id",
    "event_kind",
    "provider_source_event_ref",
    "decision_timeline_event_ref",
    "topic_key",
    "created_at",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {"const": "community_growth_event.v1"},
    "growth_event_id": {"type": "string", "minLength": 1},
    "community_id": {"type": "string", "minLength": 1},
    "event_kind": {"enum": ["attached", "split", "bridge", "rejected", "superseded"]},
    "provider_source_event_ref": {"type": "string", "minLength": 1},
    "decision_timeline_event_ref": {"type": "string", "minLength": 1},
    "topic_key": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
