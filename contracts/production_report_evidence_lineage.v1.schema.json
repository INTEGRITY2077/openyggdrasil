{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/production_report_evidence_lineage.v1.schema.json",
  "title": "OpenYggdrasil Production Report Evidence Lineage v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lineage_id",
    "phase_id",
    "lineage_scope",
    "artifact_chain",
    "required_lane_ids",
    "present_lane_ids",
    "typed_unavailable_lane_ids",
    "missing_lane_ids",
    "lineage_status",
    "readiness_state",
    "full_provenance_archive_status",
    "raw_transcript_included",
    "live_provider_readiness_claimed",
    "may_claim_91_percent_readiness",
    "reason_codes",
    "checked_at"
  ],
  "properties": {
    "schema_version": {
      "const": "production_report_evidence_lineage.v1"
    },
    "lineage_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "phase_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "lineage_scope": {
      "const": "p9_live_e2e_minimum_production_report_lineage"
    },
    "artifact_chain": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lane_id",
          "artifact_status",
          "artifact_ref",
          "producer",
          "produced_at",
          "sha256",
          "typed_unavailable_reason",
          "source_kind",
          "safe_evidence_refs",
          "contains_raw_transcript"
        ],
        "properties": {
          "lane_id": {
            "type": "string",
            "enum": [
              "e2e1_physical_session",
              "e2e2_knowledge_forest_delta",
              "e2e3_graphify_snapshot",
              "e2e4_mailbox_consumption",
              "e2e5b_reasoning_lease_isolation"
            ]
          },
          "artifact_status": {
            "type": "string",
            "enum": [
              "present",
              "typed_unavailable"
            ]
          },
          "artifact_ref": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              {
                "type": "null"
              }
            ]
          },
          "producer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "produced_at": {
            "type": "string",
            "format": "date-time"
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "typed_unavailable_reason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 160,
                "pattern": "^[A-Za-z0-9._:-]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_kind": {
            "type": "string",
            "enum": [
              "contract_artifact",
              "physical_live_artifact",
              "private_evidence_artifact",
              "real_wsl_trace",
              "typed_unavailable"
            ]
          },
          "safe_evidence_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "contains_raw_transcript": {
            "const": false
          }
        }
      }
    },
    "required_lane_ids": {
      "$ref": "#/$defs/lane_ids"
    },
    "present_lane_ids": {
      "$ref": "#/$defs/lane_ids"
    },
    "typed_unavailable_lane_ids": {
      "$ref": "#/$defs/lane_ids"
    },
    "missing_lane_ids": {
      "$ref": "#/$defs/lane_ids"
    },
    "lineage_status": {
      "type": "string",
      "enum": [
        "complete_minimum_lineage",
        "incomplete_minimum_lineage",
        "typed_unavailable"
      ]
    },
    "readiness_state": {
      "type": "string",
      "enum": [
        "ready_for_report_rebuild",
        "not_ready"
      ]
    },
    "full_provenance_archive_status": {
      "type": "string",
      "enum": [
        "deferred_not_required_for_e2e6a",
        "available"
      ]
    },
    "raw_transcript_included": {
      "const": false
    },
    "live_provider_readiness_claimed": {
      "const": false
    },
    "may_claim_91_percent_readiness": {
      "const": false
    },
    "reason_codes": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "^[A-Za-z0-9._:-]+$"
      }
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "lane_ids": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "e2e1_physical_session",
          "e2e2_knowledge_forest_delta",
          "e2e3_graphify_snapshot",
          "e2e4_mailbox_consumption",
          "e2e5b_reasoning_lease_isolation"
        ]
      }
    }
  }
}
