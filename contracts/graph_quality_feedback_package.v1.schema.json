{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/graph_quality_feedback_package.v1.schema.json",
  "title": "OpenYggdrasil Graph Quality Feedback Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "created_at",
    "producer_receipt_ref",
    "consumer_receipt_ref",
    "graph_non_sot_hint_ref",
    "graph_structure_quality_gate_ref",
    "answer_quality_signal_ref",
    "follow_up_production_request_candidate_ref",
    "quality_scorecard_ref",
    "derived_label_namespace_ref",
    "canonical_label_namespace_ref",
    "package_status",
    "portable_output",
    "evidence_refs",
    "guards",
    "no_overclaim_boundary",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {
      "const": "graph_quality_feedback_package.v1"
    },
    "package_id": {
      "$ref": "#/$defs/identifier"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer_receipt_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "consumer_receipt_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "graph_non_sot_hint_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "graph_structure_quality_gate_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "answer_quality_signal_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "follow_up_production_request_candidate_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "quality_scorecard_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "derived_label_namespace_ref": {
      "$ref": "#/$defs/derived_label_namespace_ref"
    },
    "canonical_label_namespace_ref": {
      "$ref": "#/$defs/canonical_label_namespace_ref"
    },
    "package_status": {
      "type": "string",
      "enum": [
        "typed_payload",
        "typed_unavailable",
        "reject"
      ]
    },
    "portable_output": {
      "$ref": "#/$defs/portable_output"
    },
    "evidence_refs": {
      "$ref": "#/$defs/evidence_refs"
    },
    "guards": {
      "$ref": "#/$defs/guards"
    },
    "no_overclaim_boundary": {
      "$ref": "#/$defs/no_overclaim_boundary"
    },
    "reason_codes": {
      "$ref": "#/$defs/reason_codes"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "safe_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^\\s]+$",
      "not": {
        "anyOf": [
          {
            "pattern": "^[Ff][Ii][Ll][Ee]://"
          },
          {
            "pattern": "^[A-Za-z]:"
          },
          {
            "pattern": "(?i)credential"
          },
          {
            "pattern": "(?i)raw[-_ ]?(transcript|provider|stdout|stderr)"
          }
        ]
      }
    },
    "derived_label_namespace_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/safe_ref"
        },
        {
          "pattern": "^derived-label-namespace-ref://"
        }
      ]
    },
    "canonical_label_namespace_ref": {
      "allOf": [
        {
          "$ref": "#/$defs/safe_ref"
        },
        {
          "pattern": "^canonical-label-namespace-ref://"
        }
      ]
    },
    "portable_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typed_refs_only",
        "local_filesystem_path_included",
        "raw_transcript_included",
        "raw_skill_body_included",
        "raw_stdout_included",
        "raw_stderr_included",
        "provider_context_included",
        "live_process_handles_included"
      ],
      "properties": {
        "typed_refs_only": {
          "const": true
        },
        "local_filesystem_path_included": {
          "const": false
        },
        "raw_transcript_included": {
          "const": false
        },
        "raw_skill_body_included": {
          "const": false
        },
        "raw_stdout_included": {
          "const": false
        },
        "raw_stderr_included": {
          "const": false
        },
        "provider_context_included": {
          "const": false
        },
        "live_process_handles_included": {
          "const": false
        }
      }
    },
    "evidence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "ref",
        "evidence_kind",
        "resolution_status"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/identifier"
        },
        "ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "evidence_kind": {
          "type": "string",
          "enum": [
            "producer_receipt",
            "consumer_receipt",
            "graph_non_sot_hint",
            "graph_structure_quality_gate",
            "answer_quality_signal",
            "follow_up_production_request_candidate",
            "scorecard"
          ]
        },
        "resolution_status": {
          "const": "resolved"
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 4,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/evidence_ref"
      }
    },
    "guards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graphify_as_sot",
        "answer_quality_without_evidence_refs",
        "missing_or_unresolved_evidence_refs_passed",
        "direct_canonical_mutation_by_follow_up_candidate",
        "ambiguous_derived_canonical_label_namespace",
        "stale_graph_snapshot_accepted",
        "decoy_graph_ref_accepted",
        "graph_hint_helped_answer_quality_without_scorecard_evidence",
        "raw_transcript_included",
        "raw_skill_body_included",
        "raw_stdout_included",
        "raw_stderr_included",
        "provider_context_included",
        "live_process_handles_included",
        "local_filesystem_path_included"
      ],
      "properties": {
        "graphify_as_sot": {
          "const": false
        },
        "answer_quality_without_evidence_refs": {
          "const": false
        },
        "missing_or_unresolved_evidence_refs_passed": {
          "const": false
        },
        "direct_canonical_mutation_by_follow_up_candidate": {
          "const": false
        },
        "ambiguous_derived_canonical_label_namespace": {
          "const": false
        },
        "stale_graph_snapshot_accepted": {
          "const": false
        },
        "decoy_graph_ref_accepted": {
          "const": false
        },
        "graph_hint_helped_answer_quality_without_scorecard_evidence": {
          "const": false
        },
        "raw_transcript_included": {
          "const": false
        },
        "raw_skill_body_included": {
          "const": false
        },
        "raw_stdout_included": {
          "const": false
        },
        "raw_stderr_included": {
          "const": false
        },
        "provider_context_included": {
          "const": false
        },
        "live_process_handles_included": {
          "const": false
        },
        "local_filesystem_path_included": {
          "const": false
        }
      }
    },
    "no_overclaim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reasoning_lease_solved_claimed",
        "live_readiness_claimed",
        "production_readiness_claimed",
        "public_runtime_integration_complete_claimed",
        "background_live_integration_claimed",
        "p4_h6_closed_claimed",
        "historical_ring_snapshot_read_capability_claimed",
        "hermes_answer_quality_claimed",
        "readiness_91_percent_claimed",
        "full_product_readiness_claimed"
      ],
      "properties": {
        "reasoning_lease_solved_claimed": {
          "const": false
        },
        "live_readiness_claimed": {
          "const": false
        },
        "production_readiness_claimed": {
          "const": false
        },
        "public_runtime_integration_complete_claimed": {
          "const": false
        },
        "background_live_integration_claimed": {
          "const": false
        },
        "p4_h6_closed_claimed": {
          "const": false
        },
        "historical_ring_snapshot_read_capability_claimed": {
          "const": false
        },
        "hermes_answer_quality_claimed": {
          "const": false
        },
        "readiness_91_percent_claimed": {
          "const": false
        },
        "full_product_readiness_claimed": {
          "const": false
        }
      }
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    }
  }
}
