{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/wiki_page_mutation.v1.schema.json",
  "title": "Wiki Page Mutation v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "mutation_id",
    "operation",
    "page_ref",
    "source_cell_refs",
    "reason_codes",
    "hard_nonclaims"
  ],
  "properties": {
    "schema_version": {"const": "wiki_page_mutation.v1"},
    "mutation_id": {"type": "string", "minLength": 1},
    "operation": {"type": "string", "minLength": 1},
    "page_ref": {"type": "string", "minLength": 1},
    "source_cell_refs": {"type": "array", "items": {"type": "string"}},
    "reason_codes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "before_ref": {"type": ["string", "null"]},
    "after_ref": {"type": ["string", "null"]},
    "hard_nonclaims": {"type": "array", "items": {"type": "string"}}
  }
}
