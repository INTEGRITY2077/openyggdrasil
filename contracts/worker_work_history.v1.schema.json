{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/worker_work_history.v1.schema.json",
  "title": "Worker Work History v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "work_order_id",
    "mail_id",
    "phase",
    "actor",
    "created_at",
    "summary",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "worker_work_history.v1"},
    "work_order_id": {"type": "string", "pattern": "^work-.+"},
    "delivery_id": {"type": "string"},
    "mail_id": {"type": "string", "minLength": 1},
    "recipient": {"type": "string"},
    "phase": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "minLength": 1},
    "summary": {"type": "string"},
    "next_expected_actor": {"type": "string"},
    "status": {"type": "string", "minLength": 1},
    "evidence": {"type": "object", "additionalProperties": true}
  }
}
