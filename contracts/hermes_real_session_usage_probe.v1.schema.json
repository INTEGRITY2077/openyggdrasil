{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/hermes_real_session_usage_probe.v1.schema.json",
  "title": "openyggdrasil Hermes Real Session Usage Probe v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "probe_id",
    "session_probe_id",
    "typed_task_id",
    "proof_package_status",
    "unavailable_condition",
    "reject_condition",
    "reason_codes",
    "provider_gateway_evidence_ref",
    "before_main_context_window_ref",
    "after_main_context_window_ref",
    "producer_usage_evidence_ref",
    "producer_request_ref",
    "producer_receipt_ref",
    "support_bundle_ref",
    "consumer_menu_ref",
    "consumer_usage_ref",
    "typed_result_ref",
    "typed_unavailable_ref",
    "probe_result_ref",
    "safe_portable_refs",
    "input_schema_versions",
    "ptc_callable",
    "runtime_owner",
    "transition_prep_only",
    "typed_refs_only",
    "provider_owned_gateway_evidence_present",
    "typed_task_id_returned",
    "typed_result_or_unavailable_returned",
    "producer_side_usage_evidenced",
    "consumer_side_usage_evidenced",
    "raw_transcript_included",
    "raw_provider_material_included",
    "skill_body_included",
    "provider_credential_profile_included",
    "portable_local_path_included",
    "stdin_injection_used",
    "mock_synthetic_smoke_relabelled",
    "r9_real_session_pass_claimed",
    "live_readiness_claimed",
    "production_readiness_claimed",
    "public_runtime_integration_complete_claimed",
    "background_live_integration_claimed",
    "reasoning_lease_solved_claimed",
    "p4_closure_claimed",
    "p4_h1_closed_claimed",
    "p4_h2_closed_claimed",
    "p4_h3_closed_claimed",
    "p4_h6_closed_claimed",
    "hermes_answer_quality_claimed",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "hermes_real_session_usage_probe.v1"
    },
    "probe_id": {
      "$ref": "#/$defs/identifier"
    },
    "session_probe_id": {
      "$ref": "#/$defs/nullable_identifier"
    },
    "typed_task_id": {
      "$ref": "#/$defs/nullable_identifier"
    },
    "proof_package_status": {
      "type": "string",
      "enum": [
        "pass_candidate",
        "partial_producer_candidate",
        "partial_consumer_candidate",
        "typed_unavailable",
        "reject"
      ]
    },
    "unavailable_condition": {
      "$ref": "#/$defs/nullable_identifier"
    },
    "reject_condition": {
      "$ref": "#/$defs/nullable_identifier"
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "provider_gateway_evidence_ref": {
      "$ref": "#/$defs/nullable_safe_ref"
    },
    "before_main_context_window_ref": {
      "$ref": "#/$defs/nullable_safe_ref"
    },
    "after_main_context_window_ref": {
      "$ref": "#/$defs/nullable_safe_ref"
    },
    "producer_usage_evidence_ref": {
      "$ref": "#/$defs/nullable_safe_ref"
    },
    "producer_request_ref": {
      "$ref": "#/$defs/nullable_safe_ref"
    },
    "producer_receipt_ref": {
      "$ref": "#/$defs/nullable_safe_ref"
    },
    "support_bundle_ref": {
      "$ref": "#/$defs/nullable_safe_ref"
    },
    "consumer_menu_ref": {
      "$ref": "#/$defs/nullable_safe_ref"
    },
    "consumer_usage_ref": {
      "$ref": "#/$defs/nullable_safe_ref"
    },
    "typed_result_ref": {
      "$ref": "#/$defs/nullable_safe_ref"
    },
    "typed_unavailable_ref": {
      "$ref": "#/$defs/nullable_safe_ref"
    },
    "probe_result_ref": {
      "$ref": "#/$defs/nullable_safe_ref"
    },
    "safe_portable_refs": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/safe_ref"
      }
    },
    "input_schema_versions": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "ptc_callable": {
      "const": true
    },
    "runtime_owner": {
      "const": "runtime/reasoning/hermes_real_session_usage_probe.py"
    },
    "transition_prep_only": {
      "const": true
    },
    "typed_refs_only": {
      "const": true
    },
    "provider_owned_gateway_evidence_present": {
      "type": "boolean"
    },
    "typed_task_id_returned": {
      "type": "boolean"
    },
    "typed_result_or_unavailable_returned": {
      "type": "boolean"
    },
    "producer_side_usage_evidenced": {
      "type": "boolean"
    },
    "consumer_side_usage_evidenced": {
      "type": "boolean"
    },
    "raw_transcript_included": {
      "const": false
    },
    "raw_provider_material_included": {
      "const": false
    },
    "skill_body_included": {
      "const": false
    },
    "provider_credential_profile_included": {
      "const": false
    },
    "portable_local_path_included": {
      "const": false
    },
    "stdin_injection_used": {
      "const": false
    },
    "mock_synthetic_smoke_relabelled": {
      "const": false
    },
    "r9_real_session_pass_claimed": {
      "const": false
    },
    "live_readiness_claimed": {
      "const": false
    },
    "production_readiness_claimed": {
      "const": false
    },
    "public_runtime_integration_complete_claimed": {
      "const": false
    },
    "background_live_integration_claimed": {
      "const": false
    },
    "reasoning_lease_solved_claimed": {
      "const": false
    },
    "p4_closure_claimed": {
      "const": false
    },
    "p4_h1_closed_claimed": {
      "const": false
    },
    "p4_h2_closed_claimed": {
      "const": false
    },
    "p4_h3_closed_claimed": {
      "const": false
    },
    "p4_h6_closed_claimed": {
      "const": false
    },
    "hermes_answer_quality_claimed": {
      "const": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "nullable_identifier": {
      "anyOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_safe_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/safe_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "safe_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 700,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^\\\\\\s]+$",
      "not": {
        "anyOf": [
          {
            "pattern": "^[Ff][Ii][Ll][Ee]://"
          },
          {
            "pattern": "^[A-Za-z]:"
          },
          {
            "pattern": "(?i)\\.skill\\.md"
          },
          {
            "pattern": "(?i)credential"
          },
          {
            "pattern": "(?i)profile"
          },
          {
            "pattern": "(?i)transcript"
          }
        ]
      }
    }
  }
}
