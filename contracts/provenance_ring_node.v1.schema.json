{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/provenance_ring_node.v1.schema.json",
  "title": "Provenance Ring Node v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "node_id",
    "canonical_topic",
    "decision_capsule",
    "provenance_rings",
    "lifecycle",
    "community",
    "retrieval_contract"
  ],
  "properties": {
    "schema_version": {"const": "provenance_ring_node.v1"},
    "node_id": {"type": "string", "minLength": 1},
    "canonical_topic": {
      "type": "object",
      "required": ["topic_id", "title", "page_path"],
      "additionalProperties": true,
      "properties": {
        "topic_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "page_path": {"type": "string", "minLength": 1}
      }
    },
    "decision_capsule": {
      "type": "object",
      "required": ["decision", "context", "conclusion", "evidence", "forbidden", "reuse_condition"],
      "additionalProperties": true,
      "properties": {
        "decision": {"type": "string", "minLength": 1},
        "context": {"type": "string"},
        "conclusion": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "forbidden": {"type": "array", "items": {"type": "string"}},
        "reuse_condition": {"type": "string"}
      }
    },
    "provenance_rings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ring_id", "source_ref", "origin_locator", "provider_session_id", "message_index_range", "anchor_hash", "commit_watermark", "surface_reason"],
        "additionalProperties": true,
        "properties": {
          "ring_id": {"type": "string", "minLength": 1},
          "source_ref": {"type": "string", "minLength": 1},
          "origin_locator": {"type": "string", "minLength": 1},
          "provider_session_id": {"type": "string", "minLength": 1},
          "message_index_range": {
            "type": "object",
            "required": ["start", "end"],
            "properties": {"start": {"type": "integer"}, "end": {"type": "integer"}}
          },
          "anchor_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "commit_watermark": {"type": "string", "minLength": 1},
          "surface_reason": {"type": "string"}
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "required": ["state", "created_by_ring_id", "lineage_edges"],
      "properties": {
        "state": {"enum": ["ACTIVE", "SUPERSEDED", "STALE", "REJECTED"]},
        "created_by_ring_id": {"type": "string", "minLength": 1},
        "lineage_edges": {"type": "array", "minItems": 1}
      },
      "additionalProperties": true
    },
    "community": {
      "type": "object",
      "required": ["community_id", "placement_reason", "related_nodes"],
      "properties": {
        "community_id": {"type": "string", "minLength": 1},
        "placement_reason": {"type": "string"},
        "related_nodes": {"type": "array"}
      },
      "additionalProperties": true
    },
    "retrieval_contract": {
      "type": "object",
      "required": ["keywords", "support_lanes"],
      "properties": {
        "keywords": {"type": "array", "items": {"type": "string"}},
        "support_lanes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  }
}
