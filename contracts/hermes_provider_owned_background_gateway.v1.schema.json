{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/hermes_provider_owned_background_gateway.v1.schema.json",
  "title": "openyggdrasil Hermes Provider-Owned Background Gateway v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gateway_request_id",
    "lease_request_id",
    "provider_id",
    "provider_profile",
    "provider_session_id",
    "gateway_status",
    "command",
    "invocation_surface",
    "request_mode",
    "lease_request_ref",
    "request_fingerprint_sha256",
    "input_ref_count",
    "expected_task_id_prefix",
    "typed_task_result_requirement",
    "main_context_window_proof_requirement",
    "provider_gateway_called",
    "stdin_injection_attempted",
    "raw_prompt_copied",
    "raw_session_copied",
    "state_db_result_harvested",
    "foreground_context_appended",
    "reason_codes",
    "source_refs",
    "next_action",
    "checked_at"
  ],
  "properties": {
    "schema_version": {
      "const": "hermes_provider_owned_background_gateway.v1"
    },
    "gateway_request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "lease_request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "provider_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "provider_profile": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "provider_session_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "gateway_status": {
      "type": "string",
      "enum": [
        "ready_for_provider_gateway",
        "typed_unavailable",
        "blocked_unsafe_request"
      ]
    },
    "command": {
      "const": "/background"
    },
    "invocation_surface": {
      "type": "string",
      "enum": [
        "provider_owned_command_gateway",
        "none"
      ]
    },
    "request_mode": {
      "const": "focused_background_request"
    },
    "lease_request_ref": {
      "type": "string",
      "pattern": "^reasoning-lease-request-ref://openyggdrasil/provider-owned-background-gateway/[a-f0-9]{32}$"
    },
    "request_fingerprint_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input_ref_count": {
      "type": "integer",
      "minimum": 0
    },
    "expected_task_id_prefix": {
      "const": "bg_"
    },
    "typed_task_result_requirement": {
      "const": "typed_task_id_and_typed_result_or_typed_unavailable"
    },
    "main_context_window_proof_requirement": {
      "const": "before_after_refs_or_equivalent_typed_proof"
    },
    "provider_gateway_called": {
      "const": false
    },
    "stdin_injection_attempted": {
      "const": false
    },
    "raw_prompt_copied": {
      "const": false
    },
    "raw_session_copied": {
      "const": false
    },
    "state_db_result_harvested": {
      "const": false
    },
    "foreground_context_appended": {
      "const": false
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 180
      }
    },
    "source_refs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 700
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
