{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/hermes_foreground_smoke_attempt.v1.schema.json",
  "title": "OpenYggdrasil Hermes Foreground Smoke Attempt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "run_id",
    "provider_name",
    "provider_profile",
    "launcher_manifest_status",
    "profile_manifest_status",
    "safe_bundle_ref",
    "prerequisites_ready",
    "smoke_status",
    "command",
    "runner_invoked",
    "exit_code",
    "safe_artifact_refs",
    "raw_transcript_included",
    "credential_ref_included",
    "local_path_included",
    "may_generate_e2e1",
    "may_claim_live_ready",
    "may_claim_91_percent_readiness",
    "claim_scope",
    "reason_codes",
    "checked_at"
  ],
  "properties": {
    "schema_version": {
      "const": "hermes_foreground_smoke_attempt.v1"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "provider_name": {
      "const": "hermes"
    },
    "provider_profile": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "launcher_manifest_status": {
      "type": "string",
      "enum": [
        "present",
        "typed_unavailable",
        "invalid"
      ]
    },
    "profile_manifest_status": {
      "type": "string",
      "enum": [
        "present",
        "typed_unavailable",
        "invalid"
      ]
    },
    "safe_bundle_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "prerequisites_ready": {
      "type": "boolean"
    },
    "smoke_status": {
      "type": "string",
      "enum": [
        "completed",
        "failed",
        "typed_unavailable"
      ]
    },
    "command": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "runner_invoked": {
      "type": "boolean"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "safe_artifact_refs": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/safe_ref"
      }
    },
    "raw_transcript_included": {
      "const": false
    },
    "credential_ref_included": {
      "const": false
    },
    "local_path_included": {
      "const": false
    },
    "may_generate_e2e1": {
      "const": false
    },
    "may_claim_live_ready": {
      "const": false
    },
    "may_claim_91_percent_readiness": {
      "const": false
    },
    "claim_scope": {
      "type": "string",
      "enum": [
        "foreground_smoke_prerequisites_unavailable",
        "foreground_smoke_attempt_only"
      ]
    },
    "reason_codes": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "pattern": "^[A-Za-z0-9._:-]+$"
      }
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "safe_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^\\s]+$"
    }
  }
}
