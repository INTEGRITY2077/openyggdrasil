{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/module_anchor_mapping.v1.schema.json",
  "title": "OpenYggdrasil Module Anchor Mapping v1",
  "oneOf": [
    {
      "$ref": "#/$defs/module_anchor_mapping"
    },
    {
      "$ref": "#/$defs/module_anchor_mapping_fixture"
    },
    {
      "$ref": "#/$defs/implementation_evidence_anchor_ref"
    },
    {
      "$ref": "#/$defs/typed_mapping_gap"
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "safe_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^\\s]+$",
      "not": {
        "anyOf": [
          {
            "pattern": "^[Ff][Ii][Ll][Ee]://"
          },
          {
            "pattern": "^[A-Za-z]:"
          },
          {
            "pattern": "(?i)credential"
          },
          {
            "pattern": "(?i)raw[-_ ]?(transcript|provider|stdout|stderr)"
          },
          {
            "pattern": "(?i)live[-_ ]?(process|handle|background)"
          }
        ]
      }
    },
    "fourth_anchor_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fourth_anchor_id",
        "fourth_anchor_ref",
        "responsibility_anchor_replaced_by_sixth_pair"
      ],
      "properties": {
        "fourth_anchor_id": {
          "$ref": "#/$defs/identifier"
        },
        "fourth_anchor_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "responsibility_anchor_replaced_by_sixth_pair": {
          "const": false
        }
      }
    },
    "implementation_evidence_anchor_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "evidence_id",
        "sixth_pair_id",
        "fourth_anchor_id",
        "evidence_ref"
      ],
      "properties": {
        "schema_version": {
          "const": "implementation_evidence_anchor_ref.v1"
        },
        "evidence_id": {
          "$ref": "#/$defs/identifier"
        },
        "sixth_pair_id": {
          "$ref": "#/$defs/identifier"
        },
        "fourth_anchor_id": {
          "$ref": "#/$defs/identifier"
        },
        "evidence_ref": {
          "$ref": "#/$defs/safe_ref"
        }
      }
    },
    "portable_output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typed_refs_only",
        "local_filesystem_path_included",
        "raw_material_included"
      ],
      "properties": {
        "typed_refs_only": {
          "const": true
        },
        "local_filesystem_path_included": {
          "const": false
        },
        "raw_material_included": {
          "const": false
        }
      }
    },
    "mapping_guards": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sixth_pair_replaces_fourth_responsibility_anchor",
        "missing_fourth_anchor_refs_passed",
        "missing_sixth_pair_id_passed",
        "ambiguous_mapping_passed_without_typed_gap",
        "local_path_leakage_detected",
        "readiness_overclaim_detected",
        "product_readiness_overclaim_detected",
        "live_overclaim_detected"
      ],
      "properties": {
        "sixth_pair_replaces_fourth_responsibility_anchor": {
          "const": false
        },
        "missing_fourth_anchor_refs_passed": {
          "const": false
        },
        "missing_sixth_pair_id_passed": {
          "const": false
        },
        "ambiguous_mapping_passed_without_typed_gap": {
          "const": false
        },
        "local_path_leakage_detected": {
          "const": false
        },
        "readiness_overclaim_detected": {
          "const": false
        },
        "product_readiness_overclaim_detected": {
          "const": false
        },
        "live_overclaim_detected": {
          "const": false
        }
      }
    },
    "no_overclaim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reasoning_lease_solved_claimed",
        "live_readiness_claimed",
        "production_readiness_claimed",
        "public_runtime_integration_complete_claimed",
        "background_live_integration_claimed",
        "p4_h6_closed_claimed",
        "historical_ring_snapshot_read_capability_claimed",
        "hermes_answer_quality_claimed",
        "readiness_91_percent_claimed",
        "full_product_readiness_claimed"
      ],
      "properties": {
        "reasoning_lease_solved_claimed": {
          "const": false
        },
        "live_readiness_claimed": {
          "const": false
        },
        "production_readiness_claimed": {
          "const": false
        },
        "public_runtime_integration_complete_claimed": {
          "const": false
        },
        "background_live_integration_claimed": {
          "const": false
        },
        "p4_h6_closed_claimed": {
          "const": false
        },
        "historical_ring_snapshot_read_capability_claimed": {
          "const": false
        },
        "hermes_answer_quality_claimed": {
          "const": false
        },
        "readiness_91_percent_claimed": {
          "const": false
        },
        "full_product_readiness_claimed": {
          "const": false
        }
      }
    },
    "module_anchor_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "mapping_id",
        "created_at",
        "sixth_pair_id",
        "sixth_pair_name",
        "sixth_producer_module_ref",
        "sixth_consumer_module_ref",
        "fourth_anchor_refs",
        "mapping_basis_refs",
        "implementation_evidence_anchor_refs",
        "mapping_status",
        "replacement_claim",
        "portable_output",
        "guards",
        "no_overclaim_boundary",
        "reason_codes"
      ],
      "properties": {
        "schema_version": {
          "const": "module_anchor_mapping.v1"
        },
        "mapping_id": {
          "$ref": "#/$defs/identifier"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "sixth_pair_id": {
          "$ref": "#/$defs/identifier"
        },
        "sixth_pair_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "sixth_producer_module_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "sixth_consumer_module_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "fourth_anchor_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/fourth_anchor_ref"
          }
        },
        "mapping_basis_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/safe_ref"
          }
        },
        "implementation_evidence_anchor_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/implementation_evidence_anchor_ref"
          }
        },
        "mapping_status": {
          "const": "mapped"
        },
        "replacement_claim": {
          "const": false
        },
        "typed_mapping_gap_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "portable_output": {
          "$ref": "#/$defs/portable_output"
        },
        "guards": {
          "$ref": "#/$defs/mapping_guards"
        },
        "no_overclaim_boundary": {
          "$ref": "#/$defs/no_overclaim_boundary"
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    },
    "typed_mapping_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "gap_id",
        "gap_kind",
        "reason_code",
        "resolution_status",
        "portable_output"
      ],
      "properties": {
        "schema_version": {
          "const": "typed_mapping_gap.v1"
        },
        "gap_id": {
          "$ref": "#/$defs/identifier"
        },
        "gap_kind": {
          "type": "string",
          "enum": [
            "missing_fourth_anchor",
            "missing_sixth_pair",
            "ambiguous_mapping",
            "local_path_leakage",
            "readiness_overclaim"
          ]
        },
        "sixth_pair_id": {
          "$ref": "#/$defs/identifier"
        },
        "missing_fourth_anchor": {
          "type": "boolean"
        },
        "missing_sixth_pair": {
          "type": "boolean"
        },
        "reason_code": {
          "$ref": "#/$defs/identifier"
        },
        "resolution_status": {
          "const": "typed_unavailable"
        },
        "portable_output": {
          "$ref": "#/$defs/portable_output"
        }
      }
    },
    "module_anchor_mapping_fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "fixture_id",
        "created_at",
        "mappings",
        "coverage_summary",
        "unmapped_pairs",
        "typed_mapping_gaps",
        "portable_output",
        "no_overclaim_boundary"
      ],
      "properties": {
        "schema_version": {
          "const": "module_anchor_mapping_fixture.v1"
        },
        "fixture_id": {
          "$ref": "#/$defs/identifier"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "mappings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/module_anchor_mapping"
          }
        },
        "coverage_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mapped_pair_count",
            "fourth_anchor_count",
            "typed_gap_count"
          ],
          "properties": {
            "mapped_pair_count": {
              "type": "integer",
              "minimum": 1
            },
            "fourth_anchor_count": {
              "type": "integer",
              "minimum": 1
            },
            "typed_gap_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "unmapped_pairs": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "typed_mapping_gaps": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/typed_mapping_gap"
          }
        },
        "portable_output": {
          "$ref": "#/$defs/portable_output"
        },
        "no_overclaim_boundary": {
          "$ref": "#/$defs/no_overclaim_boundary"
        }
      }
    }
  }
}
