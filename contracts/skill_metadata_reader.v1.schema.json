{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openyggdrasil.local/contracts/skill_metadata_reader.v1.schema.json",
  "title": "openyggdrasil Skill Metadata Reader v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "metadata_read_id",
    "skill_ref",
    "read_status",
    "frontmatter_ref",
    "metadata",
    "metadata_keys",
    "safe_portable_refs",
    "unavailable_condition",
    "reason_codes",
    "frontmatter_line_count",
    "body_line_count_read",
    "ptc_callable",
    "plane",
    "runtime_owner",
    "frontmatter_only",
    "skill_body_included",
    "raw_transcript_included",
    "provider_credential_profile_included",
    "portable_local_path_included",
    "plane_a_consumed",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "skill_metadata_reader.v1"
    },
    "metadata_read_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "skill_ref": {
      "$ref": "#/$defs/safe_ref"
    },
    "read_status": {
      "type": "string",
      "enum": [
        "metadata_read",
        "typed_unavailable"
      ]
    },
    "frontmatter_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/safe_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "metadata": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "maxLength": 700
          },
          {
            "type": "array",
            "maxItems": 24,
            "items": {
              "type": "string",
              "maxLength": 180
            }
          }
        ]
      },
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      }
    },
    "metadata_keys": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      }
    },
    "safe_portable_refs": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/safe_ref"
      }
    },
    "unavailable_condition": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 180
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 180,
        "pattern": "^[A-Za-z0-9._:-]+$"
      }
    },
    "frontmatter_line_count": {
      "type": "integer",
      "minimum": 0
    },
    "body_line_count_read": {
      "const": 0
    },
    "ptc_callable": {
      "const": true
    },
    "plane": {
      "const": "plane_b_frontmatter_only"
    },
    "runtime_owner": {
      "const": "runtime/reasoning/skill_metadata_reader.py"
    },
    "frontmatter_only": {
      "const": true
    },
    "skill_body_included": {
      "const": false
    },
    "raw_transcript_included": {
      "const": false
    },
    "provider_credential_profile_included": {
      "const": false
    },
    "portable_local_path_included": {
      "const": false
    },
    "plane_a_consumed": {
      "const": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "safe_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 700,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^\\\\\\s]+$",
      "not": {
        "anyOf": [
          {
            "pattern": "^[Ff][Ii][Ll][Ee]://"
          },
          {
            "pattern": "^[A-Za-z]:"
          },
          {
            "pattern": "(?i)\\.skill\\.md"
          },
          {
            "pattern": "(?i)transcript"
          },
          {
            "pattern": "(?i)credential"
          }
        ]
      }
    }
  }
}
