{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contract-ref://openyggdrasil/contracts/mailbox_intent.v1.schema.json",
  "title": "Mailbox Intent Schema v1",
  "description": "OpenYggdrasil mailbox intent ticket schema. Supports save/query/prune intents with affordance blocks for LLM-to-LLM communication.",
  "type": "object",
  "required": ["intent", "mail_id", "timestamp", "payload"],
  "properties": {
    "intent": {
      "type": "string",
      "enum": ["save", "query", "prune", "curate", "skill_update", "restore"],
      "description": "의도 유형. save=지식 저장, query=지식 검색, prune=지식 폐기 및 통폐합 정리(Gardener), curate=큐레이션, skill_update=오퍼레이터 스킬 갱신, restore=아카이브 복원."
    },
    "mail_id": {
      "type": "string",
      "description": "메일 고유 식별자. provider_prefix-timestamp-random 형식 권장."
    },
    "provider_id": {
      "type": "string",
      "description": "발행 프로바이더 식별자 (예: hermes, deepseek, claude-code)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "required": ["context_snapshot"],
      "properties": {
        "context_snapshot": {
          "type": "string",
          "description": "prune 모드: 정리 대상 topic 키워드. save 모드: 의사결정 텍스트. query 모드: 검색어."
        },
        "query_text": {
          "type": "string",
          "description": "query intent 전용 검색어."
        },
        "topic_hint": {
          "type": "string",
          "description": "주제 힌트 (분류 보조)"
        },
        "curation_type": {
          "type": "string",
          "enum": ["consolidate", "archive"],
          "description": "[prune 전용] 통폐합(consolidate) 또는 단순 격리(archive). 미지정 시 Gardener가 판정."
        }
      }
    },
    "_affordance": {
      "type": "object",
      "description": "[Q12 실험 1-A] 발행 어포던스",
      "properties": {
        "when_to_emit": {"type": "string"},
        "do_not_emit_when": {"type": "string"},
        "if_unsure": {"type": "string"}
      }
    },
    "_operator_hint": {
      "type": "object",
      "description": "[Q12 실험 2] 소비 어포던스",
      "properties": {
        "suggested_role": {
          "type": "string",
          "enum": ["distiller", "evaluator", "gardener", "pathfinder"]
        },
        "why": {"type": "string"},
        "fallback_if_ambiguous": {"type": "string"}
      }
    },
    "_execution_policy": {
      "type": "object",
      "description": "[Q12 실험 3] 실행 정책",
      "properties": {
        "mode": {"type": "string", "enum": ["immediate", "confirm"], "default": "immediate"},
        "if_wrong": {"type": "string"}
      }
    }
  }
}
